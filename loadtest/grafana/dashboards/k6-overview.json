{
  "title": "Kargoyeri Studio - k6 Load Test",
  "uid": "kargoyeri-k6",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "graph",
      "title": "VUs (active)",
      "datasource": "k6",
      "targets": [{ "measurement": "vus", "select": [[{ "type": "field", "params": ["value"] }, { "type": "mean", "params": [] }]] }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "RPS",
      "datasource": "k6",
      "targets": [{ "measurement": "http_reqs", "select": [[{ "type": "field", "params": ["value"] }, { "type": "count", "params": [] }]] }],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Response time p50/p95/p99",
      "datasource": "k6",
      "targets": [
        { "measurement": "http_req_duration", "alias": "p50", "select": [[{ "type": "field", "params": ["value"] }, { "type": "percentile", "params": [50] }]] },
        { "measurement": "http_req_duration", "alias": "p95", "select": [[{ "type": "field", "params": ["value"] }, { "type": "percentile", "params": [95] }]] },
        { "measurement": "http_req_duration", "alias": "p99", "select": [[{ "type": "field", "params": ["value"] }, { "type": "percentile", "params": [99] }]] }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 }
    },
    {
      "type": "graph",
      "title": "Errors",
      "datasource": "k6",
      "targets": [{ "measurement": "http_req_failed", "select": [[{ "type": "field", "params": ["value"] }, { "type": "sum", "params": [] }]] }],
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 }
    }
  ]
}

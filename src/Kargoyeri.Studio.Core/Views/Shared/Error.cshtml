@model ErrorViewModel
@{
    ViewData["Title"] = "Hata Olustu";
}

<section class="section-heading">
    <div>
        <p class="eyebrow">Sistem Hatasi</p>
        <h1>Beklenmeyen bir hata olustu</h1>
    </div>
</section>

<div class="split-layout split-layout--wide">
    <section class="panel-card">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;">
            <span style="font-size:2.5rem;">&#9888;&#65039;</span>
            <div>
                <h2 style="margin-bottom:4px;">Istek islenemedı</h2>
                <p style="color:var(--muted);font-size:.9rem;">
                    Bir sorun olustu. Sayfayi yenilemeyi veya ana sayfaya donmeyi deneyin.
                </p>
            </div>
        </div>

        @if (Model.ShowRequestId)
        {
            <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;margin-bottom:16px;">
                <p style="font-size:.78rem;color:var(--muted);margin-bottom:4px;">Hata Referansi (destek icin paylasin)</p>
                <code style="font-size:.85rem;color:var(--text);">@Model.RequestId</code>
            </div>
        }

        <div class="action-row action-row--left">
            <a class="primary-button" asp-controller="Home" asp-action="Index">Ana Sayfaya Don</a>
            <a class="ghost-link" onclick="history.back()" style="cursor:pointer;">Geri Git</a>
        </div>
    </section>

    <section class="panel-card panel-card--dim">
        <p class="eyebrow">Ne Yapabilirsiniz?</p>
        <ul class="clean-list" style="margin-top:12px;">
            <li>Sayfayi yenileyin (F5)</li>
            <li>Birkaç saniye bekleyip tekrar deneyin</li>
            <li>Ana sayfaya donup isleminizi tekrar baslatin</li>
            <li>Sorun devam ederse sistem yoneticinize hata referansini bildirin</li>
        </ul>
    </section>
</div>

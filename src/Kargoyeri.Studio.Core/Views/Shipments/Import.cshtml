@{
    ViewData["Title"] = "Toplu Gonderi Import";
}

<section class="section-heading">
    <div>
        <p class="eyebrow">Gonderiler</p>
        <h1>CSV ile Toplu Gonderi Olustur</h1>
    </div>
    <a class="ghost-link" asp-action="Index">Listeye Don</a>
</section>

<div class="split-layout split-layout--wide">
    <section class="panel-card">
        <div class="form-section-head" style="margin-bottom:20px;">
            <h3>CSV Dosyasi Yukle</h3>
            <p class="form-section-desc">
                Her satir bir gonderiyi temsil eder. Maksimum 5MB, UTF-8 kodlamali CSV.
            </p>
        </div>

        <form asp-action="Import" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="form-grid form-grid--dense" style="margin-bottom:20px;">
                <label class="field-span">
                    <span>CSV Dosyasi</span>
                    <input type="file" name="csvFile" accept=".csv,text/csv" required
                           style="padding:8px;background:var(--surface-2,rgba(255,255,255,.04));border:1px solid var(--border);border-radius:6px;" />
                </label>
            </div>
            <div style="display:flex;gap:12px;align-items:center;">
                <button class="primary-button" type="submit">@L["Action_Upload"]</button>
                <a class="ghost-link" asp-action="ImportTemplate">
                    Ornek Sablon Indir (.csv)
                </a>
            </div>
        </form>
    </section>

    <aside class="panel-card panel-card--dim">
        <p class="eyebrow">CSV Formati</p>
        <h3 style="margin-bottom:12px;">Sutun sirasi</h3>
        <div class="table-shell" style="overflow-x:auto;">
            <table class="studio-table" style="font-size:.78rem;">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sutun</th>
                        <th>Zorunlu</th>
                        <th>Ornek</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>Provider</td><td>âœ“</td><td>Surat, Sandbox, MNG...</td></tr>
                    <tr><td>2</td><td>OrderReference</td><td>âœ“</td><td>ORD-001</td></tr>
                    <tr><td>3</td><td>RecipientName</td><td>âœ“</td><td>Ali Veli</td></tr>
                    <tr><td>4</td><td>RecipientPhone</td><td></td><td>05551234567</td></tr>
                    <tr><td>5</td><td>RecipientCity</td><td>âœ“</td><td>Istanbul</td></tr>
                    <tr><td>6</td><td>RecipientDistrict</td><td></td><td>Kadikoy</td></tr>
                    <tr><td>7</td><td>RecipientAddress</td><td>âœ“</td><td>Moda Cad. No:1</td></tr>
                    <tr><td>8</td><td>Weight (kg)</td><td></td><td>1.5</td></tr>
                    <tr><td>9</td><td>Desi</td><td></td><td>3</td></tr>
                    <tr><td>10</td><td>CollectionAmount</td><td></td><td>150.00</td></tr>
                    <tr><td>11</td><td>IdempotencyKey</td><td></td><td>unique-key</td></tr>
                </tbody>
            </table>
        </div>
        <div style="margin-top:14px;padding:10px 12px;background:rgba(125,141,184,.07);border-radius:7px;font-size:.82rem;color:var(--muted);">
            <strong>Not:</strong> Ayirici olarak <code>;</code> (noktalÄ± virgÃ¼l) kullanilir.
            Ilk satir baslik satirdir, atlanir. Gonder bilgisi
            (sehir/adres) appsettings'ten varsayilan olarak alinir.
        </div>
    </aside>
</div>

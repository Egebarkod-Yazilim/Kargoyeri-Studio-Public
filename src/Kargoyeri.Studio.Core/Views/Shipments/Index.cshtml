                            </label>
                            <label>
                                <span>Siparis No</span>
                                <input asp-for="CreateForm.OrderReference" placeholder="ORD-001" />
                            </label>
                            <label>
                                <span>Sipariş Kaynağı</span>
                                <select asp-for="CreateForm.SourceChannel">
                                    <option value="">— Manuel (varsayılan) —</option>
                                    <optgroup label="Pazaryerleri">
                                        <option value="@OrderSourceChannelDto.Trendyol">Trendyol</option>
                                        <option value="@OrderSourceChannelDto.Hepsiburada">Hepsiburada</option>
                                        <option value="@OrderSourceChannelDto.N11">N11</option>
                                        <option value="@OrderSourceChannelDto.Pazarama">Pazarama</option>
                                        <option value="@OrderSourceChannelDto.CicekSepeti">Çiçek Sepeti</option>
                                        <option value="@OrderSourceChannelDto.PttAvm">PttAVM</option>
                                        <option value="@OrderSourceChannelDto.Modanisa">Modanisa</option>
                                        <option value="@OrderSourceChannelDto.Amazon">Amazon</option>
                                    </optgroup>
                                    <optgroup label="E-Ticaret">
                                        <option value="@OrderSourceChannelDto.NopCommerce">NopCommerce</option>
                                        <option value="@OrderSourceChannelDto.Shopify">Shopify</option>
                                        <option value="@OrderSourceChannelDto.WooCommerce">WooCommerce</option>
                                        <option value="@OrderSourceChannelDto.Ticimax">Ticimax</option>
                                        <option value="@OrderSourceChannelDto.IdeaSoft">IdeaSoft</option>
                                        <option value="@OrderSourceChannelDto.EmbeddedShop">Embedded Mini-Shop</option>
                                    </optgroup>
                                    <optgroup label="Diğer">
                                        <option value="@OrderSourceChannelDto.Manual">Manuel</option>
                                        <option value="@OrderSourceChannelDto.Custom">Diğer / Custom API</option>
                                    </optgroup>
                                </select>
                                <small class="field-hint" style="color:var(--muted);font-size:.74rem;">Sipariş aslında hangi kanaldan geldi? Telefonla geldiyse pazaryeri seçilebilir.</small>
                            </label>
                            <label>
                                <span>Tahsilat Tutari</span>
                                <input asp-for="CreateForm.CollectionAmount" type="number" step="0.01" min="0" />
                            </label>
                            <label>
                                <span>Servis Tipi</span>
                                <select asp-for="CreateForm.ServiceTier">
                                    @foreach (Kargoyeri.Studio.Core.Infrastructure.KargoyeriServiceTier tier in Enum.GetValues(typeof(Kargoyeri.Studio.Core.Infrastructure.KargoyeriServiceTier)))
                                    {
                                        <option value="@tier">@Kargoyeri.Studio.Core.Infrastructure.ServiceTypeCatalog.GetDisplayName(tier)</option>
                                    }
                                </select>
                            </label>
                        </div>
                    </div>

                    <div class="form-section-divider"></div>

                    <div class="form-section">
                        <div class="form-section-head"><h3>Alici Bilgisi</h3></div>
                        <div class="form-grid form-grid--dense">
                            <label>
                                <span>Ad Soyad</span>
                                <input asp-for="CreateForm.RecipientName" />
                            </label>
                            <label>
                                <span>Telefon</span>
                                <input asp-for="CreateForm.RecipientPhone" />
                            </label>
                            <label>
                                <span>Il</span>
                                <input asp-for="CreateForm.RecipientCity" />
                            </label>
                            <label>
                                <span>Ilce</span>
                                <input asp-for="CreateForm.RecipientDistrict" />
                            </label>
                            <label>
                                <span>Desi</span>
                                <input asp-for="CreateForm.Desi" type="number" step="0.01" min="0.01" />
                            </label>
                            <label>
                                <span>Agirlik (kg)</span>
                                <input asp-for="CreateForm.Weight" type="number" step="0.01" min="0.01" />
                            </label>
                            <label class="field-span">
                                <span>Adres</span>
                                <textarea asp-for="CreateForm.RecipientAddress" rows="2"></textarea>
                            </label>
                        </div>
                    </div>

                    <div class="shipment-actions">
                        <button class="secondary-button" type="submit">Preview Al</button>
                        @if (Model.HasReadyProvider)
                        {
                            <button class="primary-button" type="submit" formaction="@Url.Action("Create", "Shipments")">
                                Gonderiyi Olustur
                            </button>
                        }
                        else
                        {
                            <button class="primary-button" type="button" disabled>Gonderiyi Olustur</button>
                        }
                    </div>
                </form>

                @if (Model.AddressValidation?.Enabled == true)
                {
                    <section class="panel-card panel-card--dim" style="margin-top:18px;padding:16px 18px;">
                        <p class="eyebrow">Adres Dogrulama</p>
                        <h2 style="margin-bottom:8px;">@Model.AddressValidation.StatusText</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.AddressValidation.NormalizedSummary))
                        {
                            <p style="font-size:.83rem;color:var(--muted);margin-bottom:8px;">
                                Normalize edilen adres: <strong>@Model.AddressValidation.NormalizedSummary</strong>
                            </p>
                        }
                        @if (Model.AddressValidation.Issues.Any())
                        {
                            <ul class="clean-list clean-list--compact">
                                @foreach (var issue in Model.AddressValidation.Issues)
                                {
                                    <li style="color:@(issue.IsBlocking ? "#b91c1c" : "var(--muted)")">@issue.Message</li>
                                }
                            </ul>
                        }
                    </section>
                }

                @if (Model.AnomalyReport?.HasFindings == true)
                {
                    <section class="panel-card" style="margin-top:18px;border-color:rgba(217,119,6,.25);background:rgba(255,251,235,.9);">
                        <p class="eyebrow">AI Anomali Kontrolu</p>
                        <h2 style="margin-bottom:8px;">@Model.AnomalyReport.Summary</h2>
                        <ul class="clean-list clean-list--compact">
                            @foreach (var flag in Model.AnomalyReport.Flags)
                            {
                                <li><strong>@flag.Title:</strong> @flag.Message</li>
                            }
                        </ul>
                    </section>
                }
            </section>

            <aside class="shipment-aside">
                <div class="panel-card panel-card--dim">
                    <p class="eyebrow">Entegrasyon Ozeti</p>
                    <h2>@(string.IsNullOrWhiteSpace(Model.SourceSystemName) ? "Kaynak sistem bekleniyor" : Model.SourceSystemName)</h2>
                    <ul class="clean-list">
                        <li>Kaynak API: @(Model.SourceConfigured ? Model.SourceApiBaseUrl : "Henuz kayitli degil")</li>
                        <li>Hazir firma: @readyCount</li>
                        <li>Toplam kayit: @Model.Shipments.Count</li>
                    </ul>
                    <div class="action-row action-row--left" style="margin-top:18px;">
                        <a class="ghost-link" asp-controller="Workspaces" asp-action="Index">Entegrasyon ayari</a>
                        <a class="ghost-link" asp-controller="Providers" asp-action="Index">Firma ayarlari</a>
                    </div>
                </div>
            </aside>
        </div>

        @if (Model.Preview is not null)
        {
            <section class="panel-card preview-panel" style="margin-top:20px;">
                <div class="preview-metrics">
                    <div class="metric-card">
                        <span>Firma</span>
                        <strong>@Model.Preview.Provider</strong>
                    </div>
                    <div class="metric-card">
                        <span>Mapping</span>
                        <strong>@(Model.Preview.RequestMapped ? "Hazir" : "Eksik")</strong>
                    </div>
                    <div class="metric-card">
                        <span>Transport</span>
                        <strong>@(Model.Preview.LiveTransportImplemented ? "Canli" : "Simulasyon")</strong>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Preview.PayloadPreview))
                {
                    <pre class="code-block" style="margin-top:16px;">@Model.Preview.PayloadPreview</pre>
                }
            </section>
        }
</details>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    // SatÄ±ra tÄ±klanÄ±nca detail sayfasÄ±na git (action sÃ¼tununa tÄ±klama hariÃ§)
    document.querySelectorAll('tr[data-href]').forEach(function(row) {
        row.style.cursor = 'pointer';
        row.addEventListener('click', function(e) {
            if (!e.target.closest('a,button,select,form')) {
                window.location.href = row.getAttribute('data-href');
            }
        });
    });
    </script>
    <style>
    /* Inline kargo atama formu */
    .inline-assign-form {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
    }
    .inline-provider-select {
        flex: 0 0 auto;
        padding: 5px 8px;
        font-size: .78rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text);
        min-width: 110px;
    }
    .inline-assign-btn {
        flex-shrink: 0;
        font-size: .78rem;
        padding: 6px 12px;
        white-space: nowrap;
    }
    /* Admin collapse section */
    .admin-create-section {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--panel-dim);
    }
    .admin-create-summary {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        cursor: pointer;
        list-style: none;
        user-select: none;
    }
    .admin-create-summary::-webkit-details-marker { display: none; }
    .admin-create-summary:hover { background: rgba(107,156,248,.04); border-radius: var(--radius); }
    details[open] .admin-create-section { padding-bottom: 20px; }
    details[open] .admin-create-summary { border-bottom: 1px solid var(--border); }
    .status-pill--live {
        background: rgba(107,156,248,.13);
        color: #6b9cf8;
    }

    /* ── Sipariş Kaynağı (SourceChannel) chip + badge ─────────────────── */
    .source-chips {
        display:flex; flex-wrap:wrap; gap:8px;
    }
    .src-chip {
        display:inline-flex; align-items:center; gap:8px;
        padding:7px 12px; border-radius:999px;
        background:rgba(125,141,184,.08);
        border:1px solid var(--border);
        color:var(--text); text-decoration:none;
        font-size:.82rem; line-height:1;
        transition:background .15s, border-color .15s, transform .12s;
    }
    .src-chip:hover { background:rgba(107,156,248,.10); transform:translateY(-1px); }
    .src-chip.is-on { background:rgba(39,174,96,.14); border-color:rgba(39,174,96,.45); color:var(--text); }
    .src-chip .src-logo {
        width:22px; height:22px; display:inline-flex; align-items:center; justify-content:center;
        border-radius:6px; font-size:.68rem; font-weight:800;
        color:#fff; background:#7d8db8; letter-spacing:.4px;
    }
    .src-chip .src-text { font-weight:600; }
    .src-chip .src-count {
        font-size:.72rem; font-weight:700;
        background:rgba(0,0,0,.12); padding:2px 7px; border-radius:999px;
        color:var(--muted);
    }
    .src-chip.is-on .src-count { background:rgba(39,174,96,.22); color:#1e7a3b; }

    /* Tablodaki inline badge */
    .src-badge {
        display:inline-flex; align-items:center; gap:6px;
        padding:3px 8px; border-radius:999px;
        font-size:.72rem; font-weight:600;
        background:rgba(125,141,184,.08); border:1px solid var(--border);
        white-space:nowrap;
    }
    .src-badge .src-logo {
        width:18px; height:18px; display:inline-flex; align-items:center; justify-content:center;
        border-radius:5px; font-size:.6rem; font-weight:800;
        color:#fff; background:#7d8db8; letter-spacing:.3px;
    }

    /* Marka renkleri — logo arkaplan */
    .src-chip.src-tr  .src-logo,  .src-badge.src-tr  .src-logo { background:#ff6c00; }
    .src-chip.src-hb  .src-logo,  .src-badge.src-hb  .src-logo { background:#ff6000; }
    .src-chip.src-n11 .src-logo,  .src-badge.src-n11 .src-logo { background:#e84343; }
    .src-chip.src-pz  .src-logo,  .src-badge.src-pz  .src-logo { background:#ff9800; }
    .src-chip.src-cs  .src-logo,  .src-badge.src-cs  .src-logo { background:#e15686; }
    .src-chip.src-ptt .src-logo,  .src-badge.src-ptt .src-logo { background:#ffcd00; color:#1a1a1a; }
    .src-chip.src-mod .src-logo,  .src-badge.src-mod .src-logo { background:#9b5aaa; }
    .src-chip.src-amz .src-logo,  .src-badge.src-amz .src-logo { background:#ff9900; color:#1a1a1a; }
    .src-chip.src-nop .src-logo,  .src-badge.src-nop .src-logo { background:#4b8df8; }
    .src-chip.src-shp .src-logo,  .src-badge.src-shp .src-logo { background:#95bf47; }
    .src-chip.src-woo .src-logo,  .src-badge.src-woo .src-logo { background:#7f54b3; }
    .src-chip.src-tcx .src-logo,  .src-badge.src-tcx .src-logo { background:#2f4f8f; }
    .src-chip.src-ids .src-logo,  .src-badge.src-ids .src-logo { background:#3a87f9; }
    .src-chip.src-emb .src-logo,  .src-badge.src-emb .src-logo { background:#16a34a; }
    .src-chip.src-man .src-logo,  .src-badge.src-man .src-logo { background:#7d8db8; }
    .src-chip .src-all                                        { background:linear-gradient(135deg,#6b9cf8,#16a34a); }
    </style>
}

@model ShipmentWorkspaceViewModel
@using Kargoyeri.Contracts.Enums
@{
    ViewData["Title"] = "Siparisler";
    var readyCount = Model.ProviderOptions.Count(x => x.IsReady);

    // ── Sipariş Kaynağı (SourceChannel) helpers ────────────────────────────
    string SourceBadgeIcon(OrderSourceChannelDto? c, string? code) => c switch
    {
        OrderSourceChannelDto.Trendyol     => "TY",
        OrderSourceChannelDto.Hepsiburada  => "HB",
        OrderSourceChannelDto.N11          => "N11",
        OrderSourceChannelDto.Pazarama     => "PZ",
        OrderSourceChannelDto.CicekSepeti  => "ÇS",
        OrderSourceChannelDto.PttAvm       => "PTT",
        OrderSourceChannelDto.Modanisa     => "MD",
        OrderSourceChannelDto.Amazon       => "AMZ",
        OrderSourceChannelDto.GittiGidiyor => "GG",
        OrderSourceChannelDto.NopCommerce  => "NOP",
        OrderSourceChannelDto.Shopify      => "SHP",
        OrderSourceChannelDto.WooCommerce  => "WOO",
        OrderSourceChannelDto.Ticimax      => "TCX",
        OrderSourceChannelDto.IdeaSoft     => "IDS",
        OrderSourceChannelDto.EmbeddedShop => "SHP",
        OrderSourceChannelDto.Manual       => "✋",
        OrderSourceChannelDto.Custom       => "API",
        _                                  => string.IsNullOrWhiteSpace(code) ? "—" : code!.Length > 3 ? code![..3].ToUpperInvariant() : code!.ToUpperInvariant()
    };
    string SourceBadgeLabel(OrderSourceChannelDto? c, string? code) => c switch
    {
        OrderSourceChannelDto.Trendyol     => "Trendyol",
        OrderSourceChannelDto.Hepsiburada  => "Hepsiburada",
        OrderSourceChannelDto.N11          => "N11",
        OrderSourceChannelDto.Pazarama     => "Pazarama",
        OrderSourceChannelDto.CicekSepeti  => "Çiçek Sepeti",
        OrderSourceChannelDto.PttAvm       => "PttAVM",
        OrderSourceChannelDto.Modanisa     => "Modanisa",
        OrderSourceChannelDto.Amazon       => "Amazon",
        OrderSourceChannelDto.GittiGidiyor => "GittiGidiyor",
        OrderSourceChannelDto.NopCommerce  => "NopCommerce",
        OrderSourceChannelDto.Shopify      => "Shopify",
        OrderSourceChannelDto.WooCommerce  => "WooCommerce",
        OrderSourceChannelDto.Ticimax      => "Ticimax",
        OrderSourceChannelDto.IdeaSoft     => "IdeaSoft",
        OrderSourceChannelDto.EmbeddedShop => "Mini-Shop",
        OrderSourceChannelDto.Manual       => "Manuel",
        OrderSourceChannelDto.Custom       => "Diğer (API)",
        _                                  => string.IsNullOrWhiteSpace(code) ? "Bilinmiyor" : code!
    };
    string SourceBrandClass(OrderSourceChannelDto? c) => c switch
    {
        OrderSourceChannelDto.Trendyol     => "src-tr",
        OrderSourceChannelDto.Hepsiburada  => "src-hb",
        OrderSourceChannelDto.N11          => "src-n11",
        OrderSourceChannelDto.Pazarama     => "src-pz",
        OrderSourceChannelDto.CicekSepeti  => "src-cs",
        OrderSourceChannelDto.PttAvm       => "src-ptt",
        OrderSourceChannelDto.Modanisa     => "src-mod",
        OrderSourceChannelDto.Amazon       => "src-amz",
        OrderSourceChannelDto.NopCommerce  => "src-nop",
        OrderSourceChannelDto.Shopify      => "src-shp",
        OrderSourceChannelDto.WooCommerce  => "src-woo",
        OrderSourceChannelDto.Ticimax      => "src-tcx",
        OrderSourceChannelDto.IdeaSoft     => "src-ids",
        OrderSourceChannelDto.EmbeddedShop => "src-emb",
        OrderSourceChannelDto.Manual       => "src-man",
        _                                  => "src-def"
    };
}

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   BAÅLIK
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<section class="section-heading">
    <div>
        <p class="eyebrow">Kargo Yonetimi</p>
        <h1>@Model.WorkspaceName siparisleri</h1>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span class="status-pill @(Model.HasReadyProvider ? "status-pill--ready" : "status-pill--pending")">
            @(Model.HasReadyProvider ? $"{readyCount} firma hazir" : "Firma kurulumu gerekli")
        </span>
        <a class="secondary-button" style="font-size:.82rem;padding:7px 14px;"
           asp-action="Export"
           asp-route-search="@Model.Filter.Search"
           asp-route-status="@Model.Filter.Status"
           asp-route-provider="@Model.Filter.Provider">
            &#8595; CSV Indir
        </a>
        <a class="ghost-link" asp-action="Import" style="font-size:.82rem;">&#8593; Toplu Import</a>
    </div>
</section>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   FÄ°LTRE
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<div class="panel-card" style="margin-bottom:20px;">
    <form asp-action="Index" method="get" style="display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap;">
        <div style="display:flex;flex-direction:column;gap:5px;flex:2;min-width:180px;">
            <label style="font-size:.78rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;" for="search">Arama</label>
            <input type="text" id="search" name="search" value="@Model.Filter.Search"
                   placeholder="Siparis no, referans, takip no..." class="form-input" style="width:100%;" />
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;min-width:140px;">
            <label style="font-size:.78rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;" for="status">Durum</label>
            <select id="status" name="status" class="form-input">
                <option value="">Tumu</option>
                @foreach (var s in new[]{"Pending","ProviderAccepted","InTransit","Delivered","Failed","Cancelled"})
                {
                    if (Model.Filter.Status == s) { <option value="@s" selected="selected">@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;min-width:140px;">
            <label style="font-size:.78rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;" for="provider">Kargo Firmasi</label>
            <select id="provider" name="provider" class="form-input">
                <option value="">Tumu</option>
                @foreach (var p in Model.ProviderOptions)
                {
                    if (Model.Filter.Provider == p.ProviderCode) { <option value="@p.ProviderCode" selected="selected">@p.ProviderCode</option> }
                    else { <option value="@p.ProviderCode">@p.ProviderCode</option> }
                }
            </select>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;min-width:170px;">
            <label style="font-size:.78rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;" for="showArchived">Arsiv</label>
            <label style="font-size:.85rem;display:flex;align-items:center;gap:6px;cursor:pointer;height:38px;">
                <input type="checkbox" id="showArchived" name="showArchived" value="true"
                       @(Model.Filter.ShowArchived ? "checked" : "") />
                Arsivlenenleri goster
                @if (Model.TotalArchived > 0)
                {
                    <span class="cap-tag" style="font-size:.7rem;">@Model.TotalArchived</span>
                }
            </label>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
            <button type="submit" class="primary-button">Filtrele</button>
            @if (!string.IsNullOrWhiteSpace(Model.Filter.Search) || !string.IsNullOrWhiteSpace(Model.Filter.Status) || !string.IsNullOrWhiteSpace(Model.Filter.Provider) || !string.IsNullOrWhiteSpace(Model.Filter.Source) || Model.Filter.ShowArchived)
            {
                <a class="ghost-link" asp-action="Index">Temizle</a>
            }
        </div>
        @* source filter form'da hidden olarak korunur — chip linkleri bunu degistirir *@
        <input type="hidden" name="source" value="@Model.Filter.Source" />
    </form>
</div>

@* ╔══════════════════════════════════════════════════════════════════════════╗
   SİPARİŞ KAYNAĞI CHIP FİLTRESİ
   ╚══════════════════════════════════════════════════════════════════════════╝ *@
@{
    var totalAll = Model.SourceCounts.Values.Sum();
    var orderedSources = Model.SourceCounts
        .Where(kv => !string.Equals(kv.Key, "_none", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(kv => kv.Value)
        .ThenBy(kv => kv.Key)
        .ToList();
    var noneCount = Model.SourceCounts.TryGetValue("_none", out var nc) ? nc : 0;
}
@if (totalAll > 0)
{
    <div class="source-chips" style="margin-bottom:18px;">
        <a class="src-chip @(string.IsNullOrEmpty(Model.SelectedSource) ? "is-on" : "")"
           asp-action="Index"
           asp-route-search="@Model.Filter.Search"
           asp-route-status="@Model.Filter.Status"
           asp-route-provider="@Model.Filter.Provider"
           asp-route-showArchived="@Model.Filter.ShowArchived">
            <span class="src-logo src-all">∑</span>
            <span class="src-text">Tümü</span>
            <span class="src-count">@totalAll</span>
        </a>
        @foreach (var kv in orderedSources)
        {
            OrderSourceChannelDto? parsedDto = Enum.TryParse<OrderSourceChannelDto>(kv.Key, true, out var p) ? p : (OrderSourceChannelDto?)null;
            var brandCls = SourceBrandClass(parsedDto);
            var icon  = SourceBadgeIcon(parsedDto, kv.Key);
            var label = SourceBadgeLabel(parsedDto, kv.Key);
            var isOn = string.Equals(Model.SelectedSource, kv.Key, StringComparison.OrdinalIgnoreCase);
            <a class="src-chip @brandCls @(isOn ? "is-on" : "")"
               asp-action="Index"
               asp-route-source="@kv.Key"
               asp-route-search="@Model.Filter.Search"
               asp-route-status="@Model.Filter.Status"
               asp-route-provider="@Model.Filter.Provider"
               asp-route-showArchived="@Model.Filter.ShowArchived">
                <span class="src-logo">@icon</span>
                <span class="src-text">@label</span>
                <span class="src-count">@kv.Value</span>
            </a>
        }
        @if (noneCount > 0)
        {
            var isOnNone = string.Equals(Model.SelectedSource, "_none", StringComparison.OrdinalIgnoreCase);
            <a class="src-chip src-def @(isOnNone ? "is-on" : "")"
               asp-action="Index"
               asp-route-source="_none"
               asp-route-search="@Model.Filter.Search"
               asp-route-status="@Model.Filter.Status"
               asp-route-provider="@Model.Filter.Provider"
               asp-route-showArchived="@Model.Filter.ShowArchived"
               title="Kaynak bilgisi olmayan eski kayıtlar">
                <span class="src-logo">?</span>
                <span class="src-text">Belirsiz</span>
                <span class="src-count">@noneCount</span>
            </a>
        }
    </div>
}

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   SÄ°PARÄ°Å LÄ°STESÄ°
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
@if (Model.Pagination.TotalCount == 0 && Model.TotalVisibleShipments == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">&#128230;</div>
        <h2>Henuz siparis yok</h2>
        <p>Kaynak sistemden siparis geldiginde ya da toplu import / manuel olusturma ile burada gorulecek.</p>
        <a class="ghost-link" asp-action="Import">Toplu Import</a>
    </div>
}
else if (Model.Pagination.TotalCount == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">&#128270;</div>
        <h2>Eslesme bulunamadi</h2>
        <p>Filtre kriterlerinize uyan siparis yok.</p>
        <a class="ghost-link" asp-action="Index">Filtreyi Temizle</a>
    </div>
}
else
{
    <div class="table-shell">
        <table class="studio-table">
            <thead>
                <tr>
                    <th>Siparis No</th>
                    <th>Kaynak</th>
                    <th>@L["Label_Recipient"]</th>
                    <th>Firma</th>
                    <th>@L["Label_Status"]</th>
                    <th>Takip No</th>
                    <th>@L["Label_Date"]</th>
                    <th style="min-width:260px;">Kargo Entegrasyonu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in Model.Shipments)
                {
                    var isPending = shipment.Status == ShipmentStatusDto.Pending || shipment.Status == ShipmentStatusDto.Failed;
                    var isOk     = shipment.Status == ShipmentStatusDto.Delivered;
                    var isBad    = shipment.Status == ShipmentStatusDto.Failed || shipment.Status == ShipmentStatusDto.Cancelled;
                    var pillCls  = isOk ? "status-pill--ready" : isBad ? "status-pill--pending" :
                                   shipment.Status == ShipmentStatusDto.InTransit ? "status-pill--live" : "";

                    <tr data-href="@Url.Action("Detail", new { shipmentReference = shipment.ShipmentReference })">
                        <td style="font-weight:500;">
                            <a asp-action="Detail" asp-route-shipmentReference="@shipment.ShipmentReference"
                               style="color:var(--text);">@shipment.OrderReference</a>
                        </td>
                        <td>
                            @{
                                var srcCls = SourceBrandClass(shipment.SourceChannel);
                                var srcIcon = SourceBadgeIcon(shipment.SourceChannel, shipment.SourceChannelCode);
                                var srcLabel = SourceBadgeLabel(shipment.SourceChannel, shipment.SourceChannelCode);
                            }
                            <span class="src-badge @srcCls" title="@srcLabel">
                                <span class="src-logo">@srcIcon</span>
                                <span class="src-text">@srcLabel</span>
                            </span>
                        </td>
                        <td style="font-size:.82rem;color:var(--muted);">@shipment.ShipmentReference</td>
                        <td>
                            <span class="cap-tag" style="font-size:.75rem;">@shipment.Provider</span>
                        </td>
                        <td>
                            <span class="status-pill @pillCls" style="font-size:.73rem;">
                                @shipment.Status
                            </span>
                        </td>
                        <td style="font-size:.82rem;color:var(--muted);font-family:monospace;">
                            @(shipment.TrackingNumber ?? "â€”")
                        </td>
                        <td style="font-size:.78rem;color:var(--muted);">
                            @shipment.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yy HH:mm")
                        </td>
                        <td onclick="event.stopPropagation();">
                            @if (isPending && Model.ReadyProviders.Any())
                            {
                                <form asp-action="SubmitToCargo" method="post"
                                      class="inline-assign-form"
                                      onsubmit="return confirm('Bu siparis icin kargo entegrasyonu baslatilsin mi?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shipmentReference" value="@shipment.ShipmentReference" />
                                    <select name="selectedProvider" class="inline-provider-select">
                                        @foreach (var p in Model.ReadyProviders)
                                        {
                                            if (p.Provider == shipment.Provider)
                                            {
                                                <option value="@p.Provider" selected="selected">@p.ProviderCode</option>
                                            }
                                            else
                                            {
                                                <option value="@p.Provider">@p.ProviderCode</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="primary-button inline-assign-btn">
                                        Kargo Entegrasyonunu Basla
                                    </button>
                                </form>
                            }
                            else if (isPending)
                            {
                                <span style="font-size:.78rem;color:var(--muted);">Hazir firma yok</span>
                            }
                            else
                            {
                                <a class="ghost-link" asp-action="Detail"
                                   asp-route-shipmentReference="@shipment.ShipmentReference"
                                   style="font-size:.82rem;">Detay &rarr;</a>
                            }
                            @{
                                var isArchived = Model.ArchivedReferences.Contains(shipment.ShipmentReference);
                            }
                            @if (isArchived)
                            {
                                <form asp-action="Unarchive" method="post" style="display:inline;margin-left:6px;"
                                      onsubmit="return confirm('Bu gonderiyi arsivden cikarmak istiyor musunuz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shipmentReference" value="@shipment.ShipmentReference" />
                                    <button type="submit" class="ghost-link" style="font-size:.78rem;color:#0284c7;">&#8634; Geri Al</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Archive" method="post" style="display:inline;margin-left:6px;"
                                      onsubmit="return confirm('Bu gonderi arsivlensin mi? Veri silinmez, listeden gizlenir.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shipmentReference" value="@shipment.ShipmentReference" />
                                    <button type="submit" class="ghost-link" style="font-size:.78rem;color:#94a3b8;">&#128229; Arsivle</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        @if (Model.Pagination.HasPrev)
        {
            <a class="ghost-link" asp-action="Index"
               asp-route-page="@(Model.Pagination.Page - 1)"
               asp-route-search="@Model.Filter.Search"
               asp-route-status="@Model.Filter.Status"
               asp-route-provider="@Model.Filter.Provider">&larr; Onceki</a>
        }
        <span class="pagination-info">Sayfa @Model.Pagination.Page / @Model.Pagination.TotalPages &nbsp;&middot;&nbsp; @Model.Pagination.TotalCount siparis</span>
        @if (Model.Pagination.HasNext)
        {
            <a class="ghost-link" asp-action="Index"
               asp-route-page="@(Model.Pagination.Page + 1)"
               asp-route-search="@Model.Filter.Search"
               asp-route-status="@Model.Filter.Status"
               asp-route-provider="@Model.Filter.Provider">Sonraki &rarr;</a>
        }
    </div>
}

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   MUSTERI â€” Manuel Gonderi Olustur (gizlenebilir bÃ¶lÃ¼m)
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<details class="admin-create-section" style="margin-top:32px;">
    <summary class="admin-create-summary">
        <span class="eyebrow" style="margin:0;">Manuel Olusturma</span>
        <strong>Manuel Gonderi Olustur / Preview Al</strong>
        <span class="ghost-link" style="font-size:.8rem;margin-left:auto;">Genislet &darr;</span>
    </summary>

        <div class="split-layout split-layout--wide" style="margin-top:20px;">
            <section class="panel-card">
                <div class="section-heading section-heading--tight">
                    <div>
                        <p class="eyebrow">Manuel Akis</p>
                        <h2>Preview al, sonra gonderiyi olustur</h2>
                    </div>
                </div>

                <form asp-action="Preview" method="post" class="form-grid" style="margin-top:18px;">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-section">
                        <div class="form-section-head">
                            <h3>Operasyon Bilgisi</h3>
                        </div>
                        <div class="form-grid form-grid--dense">
                            <label class="field-span">
                                <span>Kargo Firmasi</span>
                                <select asp-for="CreateForm.Provider">
                                    @foreach (var option in Model.ProviderOptions)
                                    {
                                        if (option.Provider == Model.CreateForm.Provider)
                                        {
                                            <option value="@option.Provider" selected="selected">@option.DisplayName</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Provider">@option.DisplayName</option>
                                        }
                                    }

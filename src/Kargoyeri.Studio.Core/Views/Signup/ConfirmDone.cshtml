@{
    Layout = null;
    ViewData["Title"] = "Hesap Hazir";
    var tenantCode = ViewData["TenantCode"] as string;
    var email = ViewData["Email"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri</title>
    <link rel="stylesheet" href="~/_content/Kargoyeri.Studio.Core/css/site.css" asp-append-version="true" />
</head>
<body style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);min-height:100vh;display:grid;place-items:center;padding:24px;">
    <div style="max-width:480px;text-align:center;background:#fff;border-radius:14px;padding:40px 32px;box-shadow:0 10px 30px rgba(15,23,42,.08);border:1px solid #e2e8f0;">
        <div style="font-size:64px;margin-bottom:8px;color:#16a34a;">&#10003;</div>
        <h1 style="color:#14532d;margin:0 0 10px;">Hesabin hazir!</h1>
        <p style="color:#475569;font-size:.94rem;">
            <strong>@email</strong> ile hesabin etkinlestirildi. Artik giris yapabilirsin.
        </p>
        <div style="margin:18px 0;padding:14px;background:#f0fdf4;border-radius:10px;text-align:left;font-size:.84rem;">
            <div style="color:#64748b;text-transform:uppercase;font-size:.7rem;letter-spacing:.6px;">Workspace kodu</div>
            <div style="font-family:ui-monospace,monospace;font-size:1rem;color:#14532d;font-weight:700;">@tenantCode</div>
        </div>
        <a href="/access/login" style="display:inline-block;margin-top:8px;background:#16a34a;color:#fff;padding:11px 22px;border-radius:10px;font-weight:600;text-decoration:none;">
            Giris ekranina git &rarr;
        </a>
    </div>
</body>
</html>

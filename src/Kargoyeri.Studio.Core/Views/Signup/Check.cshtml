@{
    Layout = null;
    ViewData["Title"] = "E-postani Kontrol Et";
    var email = ViewData["Email"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri</title>
    <link rel="stylesheet" href="~/_content/Kargoyeri.Studio.Core/css/site.css" asp-append-version="true" />
</head>
<body style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);min-height:100vh;display:grid;place-items:center;padding:24px;">
    <div style="max-width:460px;text-align:center;background:#fff;border-radius:14px;padding:40px 32px;box-shadow:0 10px 30px rgba(15,23,42,.08);border:1px solid #e2e8f0;">
        <div style="font-size:48px;margin-bottom:8px;">&#9993;</div>
        <h1 style="color:#14532d;margin:0 0 12px;">E-postanı kontrol et</h1>
        <p style="color:#475569;font-size:.94rem;line-height:1.5;">
            <strong style="color:#0f172a;">@email</strong> adresine bir doğrulama linki gönderdik.
            Hesabını etkinleştirmek için linke tıkla. Link <strong>24 saat</strong> içinde geçerli olacak.
        </p>
        <p style="color:#94a3b8;font-size:.82rem;margin-top:18px;">
            E-posta gelmediyse spam/junk klasörünü kontrol et.
        </p>
        <a href="/signup" style="display:inline-block;margin-top:18px;color:#16a34a;font-weight:600;text-decoration:none;">
            &larr; Farkli bir e-posta ile dene
        </a>
    </div>
</body>
</html>

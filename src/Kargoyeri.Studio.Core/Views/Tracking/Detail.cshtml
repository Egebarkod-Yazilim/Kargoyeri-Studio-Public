@model PublicTrackingResultViewModel
@{
    ViewData["Title"] = $"Takip - {Model.TrackingNumber}";
    ViewData["BrandName"] = Model.BrandName;
    ViewData["BrandLogoUrl"] = Model.BrandLogoUrl;
    Layout = "_TrackLayout";

    string FormatDate(DateTimeOffset? value) => value.HasValue
        ? value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        : "-";
}

<div class="track-card">
    @if (!Model.Found)
    {
        <h1>Takip Bulunamadi</h1>
        <p class="lead">@Model.Message</p>
        <div style="margin-top:14px;">
            <a href="@Url.Action("Index")" class="primary-btn" style="display:inline-block;text-decoration:none;">Yeni Sorgu</a>
        </div>
    }
    else
    {
        @* P3-#1 â€” Visual progress hero *@
        <div class="progress-hero @(Model.IsTerminalFailure ? "is-failure" : "")">
            <div class="hero-status">
                @(Model.IsTerminalFailure ? "Gonderi Iptal / Basarisiz" : "Gonderim Durumu")
            </div>
            <h1 class="hero-headline">@Model.StatusText</h1>
            <span class="hero-tn">Takip No: @Model.TrackingNumber</span>

            <div class="progress-bar" aria-hidden="true">
                <div class="fill" style="width:@(Model.ProgressPercent)%;"></div>
            </div>

            @if (Model.ProgressSteps.Count > 0)
            {
                <div class="progress-steps" role="list" aria-label="Gonderim asamalari">
                    @foreach (var step in Model.ProgressSteps)
                    {
                        <div class="progress-step @step.State" role="listitem"
                             aria-current="@(step.State == "active" ? "step" : null)">
                            <div class="step-circle">
                                <span class="icon-emoji">@step.Icon</span>
                            </div>
                            <div class="step-label">@step.Label</div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="meta-grid">
            <div>
                <div class="k">Kargo Firmasi</div>
                <div class="v">@Model.ProviderText</div>
            </div>
            <div>
                <div class="k">Olusturma</div>
                <div class="v">@FormatDate(Model.CreatedAtUtc)</div>
            </div>
            <div>
                <div class="k">Son Guncelleme</div>
                <div class="v">@FormatDate(Model.LastUpdatedAtUtc)</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.EtaText))
            {
                <div>
                    <div class="k">Tahmini Teslim</div>
                    <div class="v">@Model.EtaText.Replace("Tahmini teslim: ", string.Empty)</div>
                </div>
            }
            <div>
                <div class="k">Teslimat Sehri</div>
                <div class="v">@(string.IsNullOrWhiteSpace(Model.RecipientCity) ? "-" : Model.RecipientCity)</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.RecipientDistrict))
            {
                <div>
                    <div class="k">Teslimat Ilcesi</div>
                    <div class="v">@Model.RecipientDistrict</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RecipientNameMasked))
            {
                <div>
                    <div class="k">@L["Label_Recipient"]</div>
                    <div class="v">@Model.RecipientNameMasked</div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.EtaText))
        {
            <div class="info-strip">
                <div>
                    <strong>@Model.EtaText</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.EtaHintText))
                    {
                        <span>@Model.EtaHintText</span>
                    }
                </div>
            </div>
        }

        @if (Model.HasMap)
        {
            <div class="map-card">
                <div class="map-card-header">
                    <div>
                        <div class="k">Yaklasik Konum</div>
                        <div class="v">@(Model.MapLabel ?? Model.MapQuery)</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.MapExternalUrl))
                    {
                        <a href="@Model.MapExternalUrl" target="_blank" rel="noopener noreferrer" class="map-link">Haritada Ac</a>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.MapPrivacyText))
                {
                    <div class="map-note">@Model.MapPrivacyText</div>
                }
                <iframe
                    src="@Model.MapEmbedUrl"
                    title="Teslimat bolgesi"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        }

        @if (Model.Timeline.Count > 0)
        {
            <div class="timeline">
                <div class="timeline-title">Hareket Gecmisi</div>
                @foreach (var ev in Model.Timeline.OrderByDescending(x => x.OccurredAtUtc))
                {
                    <div class="ev">
                        <div class="when">@FormatDate(ev.OccurredAtUtc)</div>
                        <div class="what">
                            @ev.Title
                            @if (!string.IsNullOrWhiteSpace(ev.Note))
                            {
                                <small>@ev.Note</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="kvkk-note">
            Bu sayfada gosterilen alici bilgisi KVKK uyarinca maskelenmistir. Tam bilgi sadece kargo gondericisinde mevcuttur.
        </div>

        <div style="margin-top:18px;">
            <a href="@Url.Action("Index")" style="color:#475569;text-decoration:none;font-size:13px;">&larr; Yeni sorgu</a>
        </div>
    }
</div>

@{
    Layout = null;
    var brand = ViewData["BrandName"] as string;
    var logo = ViewData["BrandLogoUrl"] as string;
    var accent = ViewData["BrandAccentColor"] as string;
    var partnerLabel = ViewData["BrandPartnerLabel"] as string;
    var footerText = ViewData["BrandFooterText"] as string;
    var hidePoweredBy = ViewData["BrandHidePoweredBy"] is bool hidden && hidden;
    var title = ViewData["Title"] ?? "Kargo Takip";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/_content/Kargoyeri.Studio.Core/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(accent))
    {
        <style>:root { --brand-accent:@accent; }</style>
    }
    <style>
        body { background:#f7f8fb; margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#0f172a; }
        .track-shell { max-width:780px; margin:0 auto; padding:32px 18px 80px; }
        .track-brand { display:flex; align-items:center; gap:14px; margin-bottom:24px; }
        .track-brand img { max-height:56px; max-width:200px; }
        .track-brand .name { font-size:20px; font-weight:600; color:var(--brand-accent,#0f172a); }
        .track-brand .sub { display:block; margin-top:4px; font-size:12px; color:#64748b; }
        .track-card { background:#fff; border-radius:14px; padding:28px; box-shadow:0 6px 22px rgba(15,23,42,.06); border:1px solid #e2e8f0; }
        .track-card h1 { margin:0 0 6px; font-size:22px; }
        .track-card p.lead { margin:0 0 20px; color:#64748b; font-size:14px; }
        .badge { display:inline-block; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:600; letter-spacing:.3px; }
        .badge.success { background:#dcfce7; color:#166534; }
        .badge.info { background:#dbeafe; color:#1e40af; }
        .badge.warning { background:#fef3c7; color:#92400e; }
        .badge.danger { background:#fee2e2; color:#991b1b; }
        .badge.neutral { background:#e2e8f0; color:#475569; }
        .meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 24px; margin:18px 0 6px; }
        .meta-grid .k { font-size:11px; text-transform:uppercase; letter-spacing:.6px; color:#94a3b8; }
        .meta-grid .v { font-size:14px; color:#0f172a; font-weight:500; }
        .timeline { margin-top:22px; border-top:1px solid #e2e8f0; padding-top:18px; }
        .timeline-title { font-size:11px; text-transform:uppercase; letter-spacing:.6px; color:#94a3b8; margin-bottom:8px; }
        .timeline .ev { display:grid; grid-template-columns:140px 1fr; gap:14px; padding:10px 0; border-bottom:1px dashed #e2e8f0; }
        .timeline .ev:last-child { border-bottom:none; }
        .timeline .ev .when { font-size:12px; color:#64748b; }
        .timeline .ev .what { font-size:14px; color:#0f172a; }
        .timeline .ev .what small { display:block; color:#64748b; font-weight:400; margin-top:2px; }
        .info-strip { margin-top:18px; padding:14px 16px; border-radius:12px; background:linear-gradient(135deg,#eff6ff,#e0f2fe); color:#0f172a; font-size:13px; }
        .info-strip strong { display:block; margin-bottom:4px; }
        .info-strip span { color:#334155; }
        .map-card { margin-top:18px; border:1px solid #dbeafe; border-radius:14px; padding:16px; background:#f8fbff; }
        .map-card-header { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; flex-wrap:wrap; margin-bottom:10px; }
        .map-card iframe { width:100%; min-height:280px; border:0; border-radius:10px; background:#e2e8f0; margin-top:12px; }
        .map-note { display:inline-flex; margin-top:4px; padding:6px 10px; border-radius:999px; background:#e2e8f0; color:#475569; font-size:12px; }
        .map-link { display:inline-flex; align-items:center; padding:8px 12px; border-radius:10px; background:#0f172a; color:#fff; text-decoration:none; font-size:13px; font-weight:600; }
        .map-link:hover { background:#1e293b; }
        .form-input { width:100%; padding:12px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px; }
        .primary-btn { background:#0f172a; color:#fff; border:none; padding:12px 22px; border-radius:10px; font-weight:600; cursor:pointer; font-size:15px; }
        .primary-btn:hover { background:#1e293b; }
        .field-error { color:#dc2626; font-size:12px; display:block; margin-top:6px; }
        .footer { text-align:center; margin-top:30px; font-size:12px; color:#94a3b8; }
        .kvkk-note { background:#f1f5f9; border-radius:10px; padding:12px 14px; font-size:12px; color:#475569; margin-top:18px; }

        /* P3-#1 — Visual progress stepper */
        .progress-hero {
            margin:6px 0 22px;
            padding:22px 20px 18px;
            border-radius:14px;
            background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);
            color:#e2e8f0;
            position:relative;
            overflow:hidden;
        }
        .progress-hero.is-failure { background:linear-gradient(135deg,#7f1d1d 0%,#991b1b 100%); }
        .progress-hero .hero-status {
            font-size:12px; text-transform:uppercase; letter-spacing:1.4px;
            color:#94a3b8; margin-bottom:6px;
        }
        .progress-hero.is-failure .hero-status { color:#fecaca; }
        .progress-hero .hero-headline { font-size:24px; font-weight:700; color:#fff; margin:0; line-height:1.2; }
        .progress-hero .hero-tn { display:block; margin-top:6px; font-size:13px; color:#cbd5e1; font-family:"SF Mono",ui-monospace,monospace; }
        .progress-hero.is-failure .hero-tn { color:#fecaca; }
        .progress-bar {
            position:relative;
            margin-top:22px;
            height:6px;
            background:rgba(148,163,184,.25);
            border-radius:999px;
            overflow:hidden;
        }
        .progress-bar .fill {
            height:100%;
            background:linear-gradient(90deg,#22c55e,#10b981);
            border-radius:999px;
            transition:width .8s cubic-bezier(.16,1,.3,1);
        }
        .progress-hero.is-failure .progress-bar .fill { background:#dc2626; }
        .progress-steps {
            display:grid;
            grid-template-columns:repeat(5,1fr);
            margin-top:18px;
            gap:6px;
        }
        .progress-step { text-align:center; position:relative; }
        .progress-step .step-circle {
            width:38px; height:38px; margin:0 auto 8px;
            border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-size:18px;
            background:rgba(148,163,184,.18);
            border:2px solid rgba(148,163,184,.28);
            transition:all .3s ease;
        }
        .progress-step .step-label {
            font-size:11px;
            font-weight:600;
            color:#94a3b8;
            letter-spacing:.3px;
            line-height:1.2;
        }
        .progress-step.completed .step-circle {
            background:#10b981; border-color:#10b981; color:#fff;
        }
        .progress-step.completed .step-circle::after {
            content:"\2713"; font-size:18px; font-weight:700;
            position:absolute; left:0; right:0;
        }
        .progress-step.completed .step-circle .icon-emoji { display:none; }
        .progress-step.completed .step-label { color:#a7f3d0; }
        .progress-step.active .step-circle {
            background:#fff; border-color:#fff; color:#0f172a;
            transform:scale(1.12);
            box-shadow:0 0 0 6px rgba(255,255,255,.12), 0 4px 18px rgba(16,185,129,.5);
            animation: stepPulse 2s ease-in-out infinite;
        }
        .progress-step.active .step-label { color:#fff; font-weight:700; }
        .progress-step.failed .step-circle {
            background:#dc2626; border-color:#dc2626; color:#fff;
        }
        .progress-step.failed .step-circle::after {
            content:"\00d7"; font-size:24px; font-weight:700; line-height:1;
            position:absolute; left:0; right:0;
        }
        .progress-step.failed .step-circle .icon-emoji { display:none; }
        .progress-step.failed .step-label { color:#fecaca; }
        @@keyframes stepPulse {
            0%, 100% { box-shadow:0 0 0 6px rgba(255,255,255,.12), 0 4px 18px rgba(16,185,129,.5); }
            50%      { box-shadow:0 0 0 10px rgba(255,255,255,.18), 0 6px 22px rgba(16,185,129,.7); }
        }

        @@media (max-width: 720px) {
            .meta-grid { grid-template-columns:1fr; }
            .timeline .ev { grid-template-columns:1fr; gap:6px; }
            .map-card iframe { min-height:220px; }
            .progress-step .step-label { font-size:9.5px; }
            .progress-step .step-circle { width:32px; height:32px; font-size:15px; }
            .progress-hero .hero-headline { font-size:20px; }
        }
    </style>
</head>
<body>
    <div class="track-shell">
        <div class="track-brand">
            @if (!string.IsNullOrWhiteSpace(logo))
            {
                <img src="@logo" alt="@brand" />
            }
            <div>
                <div class="name">@(string.IsNullOrWhiteSpace(brand) ? "Kargo Takip" : brand)</div>
                @if (!string.IsNullOrWhiteSpace(partnerLabel))
                {
                    <span class="sub">@partnerLabel</span>
                }
            </div>
        </div>
        @RenderBody()
        <div class="footer">
            @if (!hidePoweredBy)
            {
                <text>@(string.IsNullOrWhiteSpace(footerText) ? "Kargoyeri ile guclendirilmistir." : footerText)</text>
                <text>&nbsp;&middot;&nbsp;</text>
            }
            <a href="/legal/privacy" style="color:#94a3b8;">KVKK</a>
            &nbsp;&middot;&nbsp;
            <a href="/legal/cookies" style="color:#94a3b8;">Cerezler</a>
        </div>
    </div>
</body>
</html>

@model WorkerDetailViewModel
@using Kargoyeri.Contracts.Enums
@{
    ViewData["Title"] = "Worker";
    var ws = Model.WorkerStatus;
    var isHealthy = ws.IsHealthy;
    var workerPill = ws.IsRunning ? "status-pill--ready"
                   : !isHealthy  ? "status-pill--pending"
                   : ws.LastSuccessAt.HasValue ? "status-pill--ready" : "";
    var workerLabel = ws.IsRunning ? "Calisyor"
                    : !isHealthy  ? $"{ws.ConsecutiveErrors} Hata"
                    : ws.LastSuccessAt.HasValue ? "Aktif" : "Bekleniyor";

    string Ago(DateTimeOffset? dt) {
        if (!dt.HasValue) return "â€”";
        var span = DateTimeOffset.UtcNow - dt.Value;
        if (span.TotalSeconds < 60)  return $"{(int)span.TotalSeconds}s once";
        if (span.TotalMinutes < 60)  return $"{(int)span.TotalMinutes}dk once";
        if (span.TotalHours   < 24)  return $"{(int)span.TotalHours}sa once";
        return dt.Value.ToLocalTime().ToString("dd.MM.yy HH:mm");
    }
}

<div class="page-header">
    <div>
        <p class="eyebrow">Sistem</p>
        <h1 style="margin:0;font-size:1.35rem;">Worker Durumu</h1>
    </div>
    <span class="status-pill @workerPill" style="font-size:.82rem;padding:5px 14px;">@workerLabel</span>
</div>

@* â”€â”€ Metrik Kartlar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<div class="metric-strip" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;">
    <div class="metric-card" style="border-color:@(isHealthy ? "var(--border)" : "rgba(220,38,38,.3)");">
        <span>@L["Label_Status"]</span>
        <strong style="font-size:1rem;">
            <span class="status-pill @workerPill" style="font-size:.8rem;">@workerLabel</span>
        </strong>
        @if (ws.LastSuccessAt.HasValue)
        {
            <small style="font-size:.72rem;color:var(--muted);">@Ago(ws.LastSuccessAt)</small>
        }
    </div>
    <div class="metric-card">
        <span>@L["Label_Total"]</span>
        <strong>@ws.TotalProcessed</strong>
        <small style="font-size:.72rem;color:var(--muted);">Son cycle: @ws.LastProcessed adet</small>
    </div>
    <div class="metric-card">
        <span>@L["Label_Total"]</span>
        <strong>@ws.TotalCycles</strong>
        @if (ws.LastCycleStartedAt.HasValue)
        {
            <small style="font-size:.72rem;color:var(--muted);">Son: @Ago(ws.LastCycleStartedAt)</small>
        }
    </div>
    <div class="metric-card" style="border-color:@(ws.ConsecutiveErrors > 0 ? "rgba(220,38,38,.3)" : "var(--border)");">
        <span>Art Arda Hata</span>
        <strong style="color:@(ws.ConsecutiveErrors > 0 ? "#dc2626" : "var(--text)");">@ws.ConsecutiveErrors</strong>
        @if (ws.ConsecutiveErrors >= 3)
        {
            <small style="font-size:.72rem;color:#dc2626;">Worker sagliksiz!</small>
        }
    </div>
</div>

<div class="split-layout split-layout--wide">

    @* â”€â”€ Cevrim DetaylarÄ± â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
    <section class="panel-card">
        <p class="eyebrow" style="margin-bottom:14px;">Cevrim Bilgisi</p>
        <ul class="clean-list">
            <li>
                Son basarili cevrim:
                <strong>@(ws.LastSuccessAt.HasValue ? ws.LastSuccessAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "Henuz yok")</strong>
            </li>
            <li>
                Son hata zamani:
                <strong style="color:@(ws.LastErrorAt.HasValue ? "#dc2626" : "var(--muted)");">
                    @(ws.LastErrorAt.HasValue ? ws.LastErrorAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "â€”")
                </strong>
            </li>
            <li>
                Son cevrim baslangici:
                <strong>@(ws.LastCycleStartedAt.HasValue ? ws.LastCycleStartedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "â€”")</strong>
            </li>
            <li>
                Son cycle islenen:
                <strong>@ws.LastProcessed gonderi</strong>
            </li>
            @if (ws.TimeSinceLastSuccess.HasValue)
            {
                var t = ws.TimeSinceLastSuccess.Value;
                var sinceStr = t.TotalMinutes < 1 ? $"{(int)t.TotalSeconds} saniye"
                             : t.TotalHours   < 1 ? $"{(int)t.TotalMinutes} dakika"
                             : $"{(int)t.TotalHours} saat {t.Minutes} dakika";
                <li>Son basaridan bu yana: <strong>@sinceStr</strong></li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(ws.LastError))
        {
            <div class="flash flash--warn" style="margin-top:16px;">
                <strong>Son Hata:</strong><br />
                <span style="font-size:.85rem;word-break:break-word;">@ws.LastError</span>
            </div>
        }

        @* Saglik gostergesi *@
        <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:10px;">Saglik Gostergesi</p>
            <div class="readiness-bar" style="height:8px;">
                @{
                    var healthPct = isHealthy ? (ws.ConsecutiveErrors == 0 ? 100 : 66) : 33;
                    var healthColor = healthPct == 100 ? "var(--secondary)" : healthPct == 66 ? "#d97706" : "#dc2626";
                }
                <div class="readiness-fill" style="width:@healthPct%;background:@healthColor;"></div>
            </div>
            <p style="font-size:.78rem;color:var(--muted);margin-top:6px;">
                @if (healthPct == 100) { <text>Hicbir hata yok, sistem saglikli.</text> }
                else if (healthPct == 66) { <text>@ws.ConsecutiveErrors art arda hata â€” izleniyor.</text> }
                else { <text>3+ art arda hata â€” worker sagliksiz, mudahale gerekebilir.</text> }
            </p>
        </div>
    </section>

    @* â”€â”€ Ozet Istatistikler â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
    <section class="panel-card panel-card--dim">
        <p class="eyebrow" style="margin-bottom:14px;">Workspace Ozeti</p>
        <ul class="clean-list">
            <li>Aktif workspace: <strong>@Model.WorkspaceName</strong></li>
            <li>Toplam gonderi: <strong>@Model.ShipmentCount</strong></li>
            <li>Toplam bildirim: <strong>@Model.NotificationCount</strong></li>
            <li>Hazir provider: <strong>@Model.ReadyProviderCount</strong></li>
        </ul>

        <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:10px;">Hizli Erisim</p>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <a class="ghost-link" asp-controller="Shipments" asp-action="Index">Gonderi listesine git &rarr;</a>
                <a class="ghost-link" asp-controller="Notifications" asp-action="Index">Bildirim listesine git &rarr;</a>
                <a class="ghost-link" asp-controller="Providers" asp-action="Index">Kargo firmalarini goster &rarr;</a>
            </div>
        </div>
    </section>
</div>

@* â”€â”€ Son GÃ¶nderiler â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.RecentShipments.Any())
{
    <div class="section-heading" style="margin-top:8px;">
        <div>
            <p class="eyebrow">Son Aktivite</p>
            <h2>Son islenen gonderiler</h2>
        </div>
        <a class="ghost-link" asp-controller="Shipments" asp-action="Index">Tumunu Goster</a>
    </div>

    <div class="table-shell" style="margin-bottom:24px;">
        <table class="studio-table">
            <thead>
                <tr>
                    <th>Siparis No</th>
                    <th>Firma</th>
                    <th>@L["Label_Status"]</th>
                    <th>Takip No</th>
                    <th>Son Guncelleme</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.RecentShipments)
                {
                    var isOk  = s.Status == ShipmentStatusDto.Delivered;
                    var isBad = s.Status == ShipmentStatusDto.Failed || s.Status == ShipmentStatusDto.Cancelled;
                    var pillCls = isOk ? "status-pill--ready" : isBad ? "status-pill--pending" : "";
                    <tr data-href="@Url.Action("Detail", "Shipments", new { shipmentReference = s.ShipmentReference })"
                        style="cursor:pointer;">
                        <td style="font-weight:500;">
                            <a asp-controller="Shipments" asp-action="Detail"
                               asp-route-shipmentReference="@s.ShipmentReference"
                               style="color:var(--text);">@s.OrderReference</a>
                        </td>
                        <td><span class="cap-tag" style="font-size:.75rem;">@s.Provider</span></td>
                        <td>
                            <span class="status-pill @pillCls" style="font-size:.73rem;">@s.Status</span>
                        </td>
                        <td style="font-size:.82rem;color:var(--muted);font-family:monospace;">
                            @(s.TrackingNumber ?? "â€”")
                        </td>
                        <td style="font-size:.78rem;color:var(--muted);">
                            @s.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* â”€â”€ Son Bildirimler â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.RecentNotifications.Any())
{
    <div class="section-heading">
        <div>
            <p class="eyebrow">Son Aktivite</p>
            <h2>Son bildirimler</h2>
        </div>
        <a class="ghost-link" asp-controller="Notifications" asp-action="Index">Tumunu Goster</a>
    </div>

    <div class="table-shell">
        <table class="studio-table">
            <thead>
                <tr>
                    <th>Olay</th>
                    <th>Kanal</th>
                    <th>@L["Label_Status"]</th>
                    <th>Hedef</th>
                    <th>Zaman</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.RecentNotifications)
                {
                    var isOk = n.Status == Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Delivered;
                    var isFail = n.Status == Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Failed;
                    <tr>
                        <td style="font-size:.85rem;">@n.EventType</td>
                        <td><span class="cap-tag" style="font-size:.75rem;">@n.Channel</span></td>
                        <td>
                            <span class="status-pill @(isOk ? "status-pill--ready" : isFail ? "status-pill--pending" : "")"
                                  style="font-size:.73rem;">@n.Status</span>
                        </td>
                        <td style="font-size:.82rem;color:var(--muted);">@n.Address</td>
                        <td style="font-size:.78rem;color:var(--muted);">
                            @n.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
    document.querySelectorAll('tr[data-href]').forEach(function(row) {
        row.addEventListener('click', function(e) {
            if (!e.target.closest('a')) window.location.href = row.dataset.href;
        });
    });

    // SayfayÄ± 30 saniyede bir otomatik yenile (worker durumu gÃ¼ncellenir)
    setTimeout(function() { location.reload(); }, 30000);
    </script>
}

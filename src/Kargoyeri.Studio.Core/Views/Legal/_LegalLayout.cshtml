@{
    Layout = null;
    var title = ViewData["Title"] ?? "Yasal Bilgiler";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/_content/Kargoyeri.Studio.Core/css/site.css" asp-append-version="true" />
    <style>
        body { background:#f7f8fb; margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#0f172a; line-height:1.65; }
        .legal-shell { max-width:780px; margin:0 auto; padding:32px 18px 80px; }
        .legal-card { background:#fff; border-radius:14px; padding:34px 36px; box-shadow:0 6px 22px rgba(15,23,42,.06); border:1px solid #e2e8f0; }
        .legal-card h1 { margin:0 0 6px; font-size:24px; }
        .legal-card .lead { color:#64748b; font-size:13px; margin:0 0 22px; }
        .legal-card h2 { font-size:16px; margin:24px 0 8px; color:#0f172a; }
        .legal-card p, .legal-card li { font-size:14px; color:#1f2937; }
        .legal-card a { color:#1e40af; }
        .legal-nav { display:flex; gap:12px; margin-bottom:18px; flex-wrap:wrap; font-size:13px; }
        .legal-nav a { color:#475569; text-decoration:none; padding:6px 12px; background:#fff; border:1px solid #e2e8f0; border-radius:8px; }
        .legal-nav a.active, .legal-nav a:hover { background:#0f172a; color:#fff; border-color:#0f172a; }
        .footer { text-align:center; margin-top:24px; font-size:12px; color:#94a3b8; }
    </style>
</head>
<body>
    <div class="legal-shell">
        @{
            var current = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
            string Cls(string a) => a == current ? "active" : "";
        }
        <nav class="legal-nav">
            <a class="@Cls("privacy")" href="@Url.Action("Privacy")">KVKK Aydinlatma</a>
            <a class="@Cls("terms")" href="@Url.Action("Terms")">Kullanim Sartlari</a>
            <a class="@Cls("cookies")" href="@Url.Action("Cookies")">Cerez Politikasi</a>
            <a class="@Cls("datadeletion")" href="@Url.Action("DataDeletion")">Veri Silme Talebi</a>
        </nav>
        <div class="legal-card">
            @RenderBody()
        </div>
        <div class="footer">Kargoyeri Studio © @DateTime.UtcNow.Year</div>
    </div>
</body>
</html>

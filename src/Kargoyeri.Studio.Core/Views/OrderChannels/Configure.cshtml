@using Kargoyeri.Studio.Core.Controllers
@using Kargoyeri.Studio.Core.Infrastructure.OrderChannels
@model OrderChannelConfigureViewModel
@{
    ViewData["Title"] = $"{Model.Descriptor.DisplayName} • Kurulum Sihirbazı";
    var d = Model.Descriptor;
    var s = Model.State;
    var stageBadge = d.Stage switch
    {
        OrderChannelStage.Live => ("Canlı", "stage-live"),
        OrderChannelStage.Simulation => ("Simülasyon", "stage-sim"),
        OrderChannelStage.ComingSoon => ("Yakında", "stage-soon"),
        _ => ("?", "")
    };
    var disabled = d.Stage == OrderChannelStage.ComingSoon;
    var anyFieldFilled = d.Fields.Any(f => s.Fields.TryGetValue(f.Key, out var v) && !string.IsNullOrEmpty(v));
    // Sihirbazı hangi adımdan açacağız?
    var startStep = !anyFieldFilled ? 1 : (s.LastSyncUtc.HasValue ? 4 : (s.Enabled ? 4 : 3));
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.TenantName · @d.Group</p>
        <h1 style="margin:0;display:flex;align-items:center;gap:10px;">
            @d.DisplayName
            <span class="stage-badge @stageBadge.Item2">@stageBadge.Item1</span>
        </h1>
        <p style="color:var(--muted);max-width:780px;margin-top:6px;">@d.Tagline</p>
    </div>
    <a asp-action="Index" class="ghost-link" style="align-self:flex-start;">&larr; Tüm sipariş kaynakları</a>
</div>

@if (TempData["StudioMessage"] is string msg)
{
    <div class="flash" style="margin-bottom:16px;">@msg</div>
}

@if (disabled)
{
    <section class="panel-card">
        <h2 style="margin:0 0 6px;">Bu kanal henüz aktif değil</h2>
        <p style="color:var(--muted);margin:0;">UI hazır, backend ileriki sürümde devreye girecek.</p>
    </section>
}
else
{
    <section class="panel-card wizard-card">
        <!-- Stepper -->
        <ol class="wizard-steps">
            <li class="wizard-step" data-step-marker="1">
                <span class="wz-num">1</span>
                <span class="wz-label">Hazırlık</span>
                <span class="wz-sub">API bilgilerini bul</span>
            </li>
            <li class="wizard-step" data-step-marker="2">
                <span class="wz-num">2</span>
                <span class="wz-label">Kimlik Bilgileri</span>
                <span class="wz-sub">@d.Fields.Count(f => f.Required) zorunlu alan</span>
            </li>
            <li class="wizard-step" data-step-marker="3">
                <span class="wz-num">3</span>
                <span class="wz-label">Bağlantı Testi</span>
                <span class="wz-sub">Doğruluk kontrolü</span>
            </li>
            <li class="wizard-step" data-step-marker="4">
                <span class="wz-num">4</span>
                <span class="wz-label">Aktivasyon</span>
                <span class="wz-sub">Kanalı aç & kaydet</span>
            </li>
        </ol>

        <form asp-action="Save" method="post" id="wizardForm" class="channel-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Channel" value="@d.Code" />

            <!-- Step 1: Hazırlık -->
            <div class="wizard-pane" data-step="1">
                <h2 style="margin:0 0 8px;">1 · Hazırlık</h2>
                <p style="color:var(--muted);margin:0 0 14px;">
                    @d.DisplayName satıcı panelinden alacağın bilgileri yanına hazırla. Bu sihirbaz seni adım adım kayıt sürecinden geçirecek.
                </p>

                <div class="prep-list">
                    @foreach (var field in d.Fields.Where(f => f.Required))
                    {
                        <div class="prep-item">
                            <div class="prep-icon">@(field.Secret ? "🔒" : "🔑")</div>
                            <div>
                                <strong>@field.Label</strong>
                                @if (!string.IsNullOrWhiteSpace(field.Hint))
                                {
                                    <p style="margin:2px 0 0;font-size:.82rem;color:var(--muted);">@field.Hint</p>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(d.DocsUrl))
                {
                    <p style="margin:14px 0 0;">
                        <a href="@d.DocsUrl" target="_blank" rel="noopener" class="ghost-link">📘 Resmi API Dokümanı &rarr;</a>
                    </p>
                }
            </div>

            <!-- Step 2: Kimlik Bilgileri -->
            <div class="wizard-pane" data-step="2">
                <h2 style="margin:0 0 8px;">2 · Kimlik Bilgileri</h2>
                <p style="color:var(--muted);margin:0 0 14px;">
                    Satıcı panelinden aldığın bilgileri eksiksiz gir. Gizli alanlar şifrelenmiş olarak saklanır.
                </p>

                @foreach (var field in d.Fields)
                {
                    var fieldValue = s.Fields.TryGetValue(field.Key, out var v) ? v : "";
                    var hasStored = field.Secret && !string.IsNullOrEmpty(fieldValue);

                    <label class="wz-field">
                        <span class="wz-field-label">
                            @field.Label
                            @if (field.Required) { <span class="field-required">zorunlu</span> }
                            else { <span class="field-optional">opsiyonel</span> }
                        </span>
                        @if (field.Secret)
                        {
                            <input type="password" autocomplete="new-password"
                                   name="Fields[@field.Key]"
                                   data-required="@(field.Required ? "1" : "0")"
                                   data-stored="@(hasStored ? "1" : "0")"
                                   placeholder="@(hasStored ? "(kayıtlı — değiştirmek için yeni değer gir)" : field.Placeholder)" />
                            @if (hasStored)
                            {
                                <small class="field-hint" style="color:#16a34a;">✓ Değer kayıtlı. Boş bırakırsan korunur.</small>
                            }
                        }
                        else
                        {
                            <input type="text" name="Fields[@field.Key]"
                                   data-required="@(field.Required ? "1" : "0")"
                                   value="@fieldValue" placeholder="@field.Placeholder" />
                        }
                        @if (!string.IsNullOrWhiteSpace(field.Hint))
                        {
                            <small class="field-hint">@field.Hint</small>
                        }
                    </label>
                }

                <div class="wz-validation-msg" id="step2Msg"></div>
            </div>

            <!-- Step 3: Bağlantı Testi -->
            <div class="wizard-pane" data-step="3">
                <h2 style="margin:0 0 8px;">3 · Bağlantı Testi</h2>
                <p style="color:var(--muted);margin:0 0 14px;">
                    Girdiğin bilgileri kaydetmeden önce, @d.DisplayName API'sine gerçek bir test çağrısı atalım. Bu adım opsiyoneldir
                    ama önemle önerilir.
                </p>

                <div class="test-action-box">
                    <p style="margin:0 0 10px;font-size:.9rem;">
                        <strong>Önemli:</strong> Test öncesinde bu sayfada henüz <em>kaydetmediğin</em> değerler test edilmez —
                        önce <strong>4. adımdaki Kaydet</strong>'e basıp dönmen, sonra test atman gerekir.
                        Eğer pazaryeri bilgileri zaten kayıtlıysa, bu adımdan testi tetikleyebilirsin.
                    </p>
                </div>

                @if (anyFieldFilled)
                {
                    <p style="margin:10px 0 0;">
                        <button type="button" class="ghost-link" onclick="document.getElementById('outerTestForm').submit();">
                            🔌 Şimdi Bağlantıyı Test Et
                        </button>
                    </p>
                }
                else
                {
                    <p style="color:var(--muted);font-size:.85rem;margin:0;">
                        Henüz kayıtlı bilgi yok. Önce 4. adımda <strong>Kaydet</strong>'e bas, sonra bu sayfaya dönüp testi tetikle.
                    </p>
                }
            </div>

            <!-- Step 4: Aktivasyon -->
            <div class="wizard-pane" data-step="4">
                <h2 style="margin:0 0 8px;">4 · Aktivasyon</h2>
                <p style="color:var(--muted);margin:0 0 14px;">
                    Son adım: kanalı aktif kullanıma al ve varsayılan kargo firmasını seç.
                </p>

                <label class="toggle-row-v2" style="margin:6px 0 14px;">
                    <div>
                        <strong>Bu kanalı aktif kullan</strong>
                        <p style="margin:2px 0 0;font-size:.8rem;color:var(--muted);">
                            Kapatıldığında bu kanaldan otomatik sipariş çekimi yapılmaz.
                        </p>
                    </div>
                    <input type="checkbox" name="Enabled" value="true" @(s.Enabled ? "checked" : "")
                           style="width:20px;height:20px;" />
                </label>

                <label class="wz-field">
                    <span class="wz-field-label">Varsayılan kargo firması <span class="field-optional">opsiyonel</span></span>
                    <input type="text" name="DefaultProvider"
                           value="@s.DefaultProvider"
                           placeholder="örnk: aras, mng, yurtici, surat" />
                    <small class="field-hint">Bu kanaldan gelen siparişler için ön-seçili kargo firması.</small>
                </label>

                @if (s.Enabled && s.LastSyncUtc.HasValue)
                {
                    <p style="font-size:.82rem;color:#27ae60;margin:10px 0 0;">
                        ✓ <strong>Son sync:</strong> @s.LastSyncUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>
                }

                <div style="background:rgba(39,174,96,.08);padding:12px 14px;border-radius:8px;margin-top:14px;border:1px solid rgba(39,174,96,.2);">
                    <strong>🚀 Hazırsın!</strong>
                    <p style="margin:4px 0 0;font-size:.85rem;color:var(--muted);">
                        Kaydet'e bastıktan sonra otomatik senkronizasyon arka planda çalışmaya başlar. Dilediğin zaman
                        manuel "Şimdi Sipariş Çek" butonuyla da tetikleyebilirsin.
                    </p>
                </div>
            </div>

            <!-- Footer -->
            <div class="wizard-footer">
                <button type="button" class="ghost-link" id="wzPrev">&larr; Geri</button>
                <span class="wz-progress-text" id="wzProgressText">Adım 1 / 4</span>
                <button type="button" class="primary-button" id="wzNext">İleri &rarr;</button>
                <button type="submit" class="primary-button" id="wzSave" style="display:none;">💾 Kaydet</button>
            </div>
        </form>

        <!-- Test formu (form içinde olmadan post) -->
        @if (anyFieldFilled)
        {
            <form asp-action="Test" asp-route-channel="@d.Code" method="post" id="outerTestForm" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
        }
    </section>

    <!-- Yan Aksiyonlar -->
    <section class="panel-card" style="margin-top:16px;">
        <h3 style="margin:0 0 10px;">Hızlı Aksiyonlar</h3>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            @if (anyFieldFilled)
            {
                <form asp-action="Test" asp-route-channel="@d.Code" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ghost-link">🔌 Bağlantı Testi</button>
                </form>
            }
            @if (s.Enabled)
            {
                <form asp-action="Sync" asp-route-channel="@d.Code" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="secondary-button">⏬ Şimdi Sipariş Çek</button>
                </form>
            }
            @if (!string.IsNullOrEmpty(d.DocsUrl))
            {
                <a href="@d.DocsUrl" target="_blank" rel="noopener" class="ghost-link">📘 API Dokümanı &rarr;</a>
            }
        </div>
    </section>
}

@if (Model.RecentRuns.Any())
{
    <section class="panel-card" style="margin-top:16px;">
        <h3 style="margin:0 0 10px;">Bu Kanalın Son Senkronizasyonları</h3>
        <table class="data-table" style="font-size:.85rem;">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Çekilen</th>
                    <th>Mesaj</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.RecentRuns)
                {
                    <tr>
                        <td>@r.StartedAtUtc.ToLocalTime().ToString("dd.MM HH:mm:ss")</td>
                        <td>@(r.Success ? "OK" : "Hata")@(r.IsSimulation ? " (sim)" : "")</td>
                        <td>@r.FetchedCount</td>
                        <td style="color:var(--muted);">@r.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@section Scripts {
    <style>
        .stage-badge {
            font-size: .7rem; font-weight: 600;
            padding: 3px 8px; border-radius: 12px; white-space: nowrap;
        }
        .stage-live { background: rgba(39,174,96,.12); color:#27ae60; border:1px solid rgba(39,174,96,.3); }
        .stage-sim  { background: rgba(212,160,23,.12); color:#d4a017; border:1px solid rgba(212,160,23,.3); }
        .stage-soon { background: rgba(125,141,184,.12); color:#7d8db8; border:1px solid rgba(125,141,184,.25); }

        .wizard-card { padding: 22px 26px; }
        .wizard-steps {
            list-style:none; padding:0; margin:0 0 22px;
            display:grid; grid-template-columns: repeat(4, 1fr); gap:6px;
            counter-reset: step;
        }
        .wizard-step {
            position:relative; padding:10px 12px; border-radius:8px;
            background: rgba(125,141,184,.06);
            border:1px solid rgba(125,141,184,.18);
            display:flex; flex-direction:column; gap:2px;
            transition: all .2s ease;
        }
        .wizard-step::after {
            content:""; position:absolute; right:-6px; top:50%;
            width:0; height:0; border:6px solid transparent;
            border-left-color: rgba(125,141,184,.18);
            transform: translateY(-50%);
        }
        .wizard-step:last-child::after { display:none; }
        .wizard-step .wz-num {
            display:inline-flex; align-items:center; justify-content:center;
            width:24px; height:24px; border-radius:50%;
            background: rgba(125,141,184,.2); color: var(--muted);
            font-weight:700; font-size:.8rem;
        }
        .wizard-step .wz-label { font-weight:600; font-size:.88rem; margin-top:4px; }
        .wizard-step .wz-sub { font-size:.72rem; color:var(--muted); }

        .wizard-step.is-active {
            background: linear-gradient(135deg, rgba(232,164,90,.14), rgba(232,164,90,.04));
            border-color: rgba(232,164,90,.5);
            box-shadow: 0 2px 10px rgba(232,164,90,.18);
        }
        .wizard-step.is-active .wz-num { background:#e8a45a; color:#fff; }
        .wizard-step.is-active .wz-label { color: var(--text); }

        .wizard-step.is-done {
            background: rgba(39,174,96,.08);
            border-color: rgba(39,174,96,.35);
        }
        .wizard-step.is-done .wz-num { background:#27ae60; color:#fff; font-size:0; }
        .wizard-step.is-done .wz-num::before { content:"✓"; font-size:.9rem; font-weight:700; }

        .wizard-pane { display:none; min-height: 280px; padding:6px 0; }
        .wizard-pane.is-active { display:block; animation: fadeSlide .25s ease; }
        @@keyframes fadeSlide {
            from { opacity:0; transform: translateY(6px); }
            to   { opacity:1; transform: none; }
        }

        .wizard-footer {
            display:flex; align-items:center; justify-content:space-between;
            margin-top: 22px; padding-top: 16px;
            border-top: 1px solid var(--border);
            gap:12px;
        }
        .wz-progress-text { font-size:.85rem; color:var(--muted); }

        .channel-form input[type="text"], .channel-form input[type="password"] {
            width: 100%; padding:8px 10px; font-size:.92rem;
        }
        .wz-field { display:block; margin-bottom:14px; }
        .wz-field-label { display:block; margin-bottom:4px; font-weight:500; }
        .field-hint { display:block;margin-top:4px;font-size:.76rem;color:var(--muted); }
        .field-required { font-size:.7rem;color:#e8a45a;font-weight:600;margin-left:4px; }
        .field-optional { font-size:.7rem;color:var(--muted);margin-left:4px; }
        .wz-validation-msg { color:#e63946; font-size:.85rem; margin-top:6px; min-height:1.2em; }

        .prep-list { display:flex; flex-direction:column; gap:10px; margin:6px 0; }
        .prep-item {
            display:flex; gap:12px; align-items:flex-start;
            padding:10px 12px; border-radius:8px;
            background: rgba(125,141,184,.06);
            border:1px solid rgba(125,141,184,.15);
        }
        .prep-icon { font-size:1.2rem; line-height:1; }

        .test-action-box {
            background: rgba(125,141,184,.06);
            padding: 12px 14px; border-radius:8px;
            border:1px solid rgba(125,141,184,.18);
        }
    </style>

    <script>
    (function () {
        const TOTAL = 4;
        let current = @startStep;

        const steps = document.querySelectorAll('.wizard-step');
        const panes = document.querySelectorAll('.wizard-pane');
        const btnPrev = document.getElementById('wzPrev');
        const btnNext = document.getElementById('wzNext');
        const btnSave = document.getElementById('wzSave');
        const progress = document.getElementById('wzProgressText');
        const step2Msg = document.getElementById('step2Msg');

        function render() {
            steps.forEach((el, i) => {
                const n = i + 1;
                el.classList.remove('is-active', 'is-done');
                if (n < current) el.classList.add('is-done');
                else if (n === current) el.classList.add('is-active');
            });
            panes.forEach(p => {
                p.classList.toggle('is-active', parseInt(p.getAttribute('data-step'), 10) === current);
            });
            btnPrev.style.visibility = current === 1 ? 'hidden' : 'visible';
            const onLast = current === TOTAL;
            btnNext.style.display = onLast ? 'none' : '';
            btnSave.style.display = onLast ? '' : 'none';
            progress.textContent = `Adım ${current} / ${TOTAL}`;
            step2Msg.textContent = '';
        }

        function validateStep2() {
            // Required alanlar dolu mu? Secret + stored=1 ise boş kabul edilebilir.
            const inputs = document.querySelectorAll('.wizard-pane[data-step="2"] input[name^="Fields["]');
            const missing = [];
            inputs.forEach(inp => {
                const req = inp.getAttribute('data-required') === '1';
                const stored = inp.getAttribute('data-stored') === '1';
                if (req && !inp.value.trim() && !stored) {
                    const lbl = inp.closest('.wz-field')?.querySelector('.wz-field-label')?.childNodes[0]?.textContent?.trim() || inp.name;
                    missing.push(lbl);
                    inp.style.borderColor = '#e63946';
                } else {
                    inp.style.borderColor = '';
                }
            });
            if (missing.length) {
                step2Msg.textContent = 'Eksik zorunlu alanlar: ' + missing.join(', ');
                return false;
            }
            return true;
        }

        btnNext.addEventListener('click', () => {
            if (current === 2 && !validateStep2()) return;
            if (current < TOTAL) { current++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
        });
        btnPrev.addEventListener('click', () => {
            if (current > 1) { current--; render(); }
        });
        steps.forEach(el => {
            el.addEventListener('click', () => {
                const n = parseInt(el.getAttribute('data-step-marker'), 10);
                // Sadece tamamlanmış / aktif adımlara serbestçe atla
                if (n <= current || (current >= 2 && n === current + 1)) {
                    if (current === 2 && n > 2 && !validateStep2()) return;
                    current = n; render();
                }
            });
        });

        render();
    })();
    </script>
}

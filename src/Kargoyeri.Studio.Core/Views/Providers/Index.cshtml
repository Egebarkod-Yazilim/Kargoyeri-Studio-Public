@model ProviderIndexViewModel
@functions {
    static string OpTr(string op) => op switch
    {
        "CreateShipment"     => "Gonderi Olustur",
        "TrackShipment"      => "Kargo Takip",
        "CancelShipment"     => "Iptal",
        "GetLabel"           => "Etiket / Barkod",
        "GetBranches"        => "Sube Listesi",
        "GetCities"          => "Sehir Listesi",
        "GetDistricts"       => "Ilce Listesi",
        "GetServicePoints"   => "Servis Noktasi",
        "GetPriceList"       => "Fiyat Listesi",
        "RescheduleDelivery" => "Teslimat Planla",
        "ReturnShipment"     => "Iade",
        _                    => op
    };

    static (string Label, string Css) IntegrationBadge(string providerCode) => providerCode.ToLower() switch
    {
        "surat"           => ("REST",        "ibadge--rest"),
        "hepsijet"        => ("REST + Token","ibadge--rest"),
        "mng"             => ("SOAP",        "ibadge--soap"),
        "aras"            => ("SOAP",        "ibadge--soap"),
        "ptt"             => ("SOAP",        "ibadge--soap"),
        "ups"             => ("OAuth2 REST", "ibadge--oauth"),
        "trendyolexpress" => ("Marketplace", "ibadge--market"),
        "yurtici"         => ("Simulasyon",  "ibadge--sim"),
        _                 => ("Sandbox",     "ibadge--sim")
    };

    static string CancelNote(string providerCode) => providerCode.ToLower() switch
    {
        "ptt"             => "Iptal yok",
        "trendyolexpress" => "Iptal yok",
        _                 => ""
    };
}
@{
    ViewData["Title"] = "Kargo Firmalari";
    int readyCount   = Model.Providers.Count(p => p.Status.CanCreateShipment);
    int liveCount    = Model.Providers.Count(p => p.Status.LiveTransportImplemented);
    int pendingCount = Model.Providers.Count - readyCount;
    int healthCount  = Model.HealthSnapshots.Count(x => x.HasData);
}

<section class="section-heading">
    <div>
        <p class="eyebrow">Kargo Firmalari</p>
        <h1>@Model.WorkspaceName</h1>
    </div>
</section>

<div class="stats-bar">
    <div class="stat-item">
        <strong>@Model.Providers.Count</strong>
        <span>@L["Label_Total"]</span>
    </div>
    <div class="stats-bar-sep"></div>
    <div class="stat-item">
        <strong>@readyCount</strong>
        <span>Hazir</span>
    </div>
    <div class="stats-bar-sep"></div>
    <div class="stat-item">
        <strong>@liveCount</strong>
        <span>Canli API</span>
    </div>
    <div class="stats-bar-sep"></div>
    <div class="stat-item">
        <strong>@pendingCount</strong>
        <span>Kurulum Bekliyor</span>
    </div>
</div>

<section class="panel-card" style="margin:18px 0 24px;">
    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:14px;">
        <div>
            <p class="eyebrow" style="margin-bottom:4px;">Saglik Dashboard'u</p>
            <h3 style="margin:0;">Son 24 Saat Provider Probe Durumu</h3>
        </div>
        <span class="status-pill @(healthCount > 0 ? "status-pill--ready" : "status-pill--pending")">
            @(healthCount > 0 ? $"{healthCount} provider olculdu" : "Veri toplanÄ±yor")
        </span>
    </div>

    @if (healthCount == 0)
    {
        <p style="margin:0;color:var(--muted);font-size:.88rem;">
            Health probe servisi endpoint'leri periyodik olarak yokluyor. Ilk olcumler geldikce burada
            success rate, error rate ve P95 latency gorunecek.
        </p>
    }
    else
    {
        <div class="table-shell" style="overflow-x:auto;">
            <table class="studio-table" style="font-size:.84rem;">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>Success</th>
                        <th>Error Rate</th>
                        <th>P95</th>
                        <th>Probe</th>
                        <th>Son Olcum</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var health in Model.HealthSnapshots.OrderByDescending(x => x.SuccessRate).ThenBy(x => x.ProviderName))
                {
                    <tr>
                        <td>
                            <strong>@health.ProviderName</strong>
                            @if (!string.IsNullOrWhiteSpace(health.LastError))
                            {
                                <div style="font-size:.76rem;color:#dc2626;margin-top:4px;">Son hata: @health.LastError</div>
                            }
                        </td>
                        <td>@health.SuccessRate.ToString("0.0")%</td>
                        <td>@health.ErrorRate.ToString("0.0")%</td>
                        <td>@(health.P95LatencyMs.HasValue ? $"{health.P95LatencyMs} ms" : "â€”")</td>
                        <td>@health.ProbeCount</td>
                        <td>@(health.LastCheckedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "â€”")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Providers.Count == 0)
{
    <div class="flash">
        Bu musteride gorunur kargo firmasi henuz tanimlanmadi. Admin once entegrasyon ekranindan izinli firmalari secmeli.
    </div>
}
else if (readyCount == 0)
{
    <div class="flash">
        Henuz hazir kargo firmaniz yok. Bir firmaya tiklayip API bilgilerini girerek entegrasyonu aktif hale getirin.
    </div>
}

<div class="provider-grid-v2">
    @foreach (var card in Model.Providers)
    {
        var ops        = card.Profile.SupportedOperations.ToList();
        var badge      = IntegrationBadge(card.Profile.ProviderCode);
        var cancelNote = CancelNote(card.Profile.ProviderCode);

        <article class="provider-card-v2">
            <div class="provider-card-v2-head @card.Visual.AccentClass">
                @if (!string.IsNullOrWhiteSpace(card.Visual.ImageUrl))
                {
                    <img src="@card.Visual.ImageUrl" alt="@card.Visual.ProviderName" loading="lazy"
                         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.22;" />
                }
                <div style="position:relative;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                        <h2 style="margin:0;">@card.Visual.ProviderName</h2>
                        <span class="integration-badge @badge.Css">@badge.Label</span>
                    </div>
                    <p style="margin:5px 0 0;font-size:.8rem;opacity:.82;">@card.Visual.Headline</p>
                </div>
            </div>

            <div class="provider-card-v2-body">
                @* Durum satiri *@
                <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                    <span class="status-pill @(card.Status.CanCreateShipment ? "status-pill--ready" : "status-pill--pending")">
                        @(card.Status.CanCreateShipment ? "Hazir" : "Kurulum Gerekli")
                    </span>
                    @if (card.Status.LiveTransportImplemented)
                    {
                        <span class="status-pill status-pill--live">Canli API</span>
                    }
                    else if (card.Status.SimulationEnabled)
                    {
                        <span class="status-pill status-pill--pending">Simulasyon</span>
                    }
                    @if (!string.IsNullOrEmpty(cancelNote))
                    {
                        <span class="cap-tag" style="font-size:.72rem;background:rgba(203,92,45,.1);color:#e05c4e;border-color:rgba(203,92,45,.2);">
                            @cancelNote
                        </span>
                    }
                </div>

                @* Desteklenen operasyonlar â€” Turkce *@
                @if (ops.Count > 0)
                {
                    <div class="cap-list" style="margin-top:10px;">
                        @foreach (var op in ops.Take(4))
                        {
                            <span class="cap-tag @(card.Status.CanCreateShipment ? "" : "cap-tag--dim")" style="font-size:.75rem;">
                                @OpTr(op)
                            </span>
                        }
                        @if (ops.Count > 4)
                        {
                            <span class="cap-tag cap-tag--dim" style="font-size:.75rem;">+@(ops.Count - 4)</span>
                        }
                    </div>
                }

                @* Eksik alan uyarisi *@
                @if (card.Status.MissingSettings.Count > 0)
                {
                    <p style="font-size:.81rem;color:var(--accent);margin:8px 0 0;">
                        @card.Status.MissingSettings.Count eksik alan &mdash;
                        @string.Join(", ", card.Status.MissingSettings.Take(2))@(card.Status.MissingSettings.Count > 2 ? "..." : "")
                    </p>
                }
            </div>

            <div class="provider-card-v2-foot">
                @if (User.IsInRole("StudioSuperAdmin"))
                {
                    <a class="primary-button" asp-action="Configure" asp-route-id="@card.Profile.ProviderCode"
                       style="font-size:.88rem;padding:9px 16px;">
                        @(card.Status.CanCreateShipment ? "Ayarlari Duzenle" : "Kurulumu Baslat")
                    </a>
                }
                @if (card.Status.CanCreateShipment)
                {
                    <a class="ghost-link" asp-controller="Shipments" asp-action="Index"
                       style="font-size:.85rem;">Gonderiler</a>
                }
            </div>
        </article>
    }
</div>

@section Scripts {
    <style>
        .integration-badge {
            display: inline-block;
            font-size: .68rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            letter-spacing: .03em;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .ibadge--rest    { background:rgba(52,152,219,.25);  color:#e8f4fd; }
        .ibadge--soap    { background:rgba(212,160,23,.25);  color:#fef9e7; }
        .ibadge--oauth   { background:rgba(139,69,19,.3);    color:#f5e6d3; }
        .ibadge--market  { background:rgba(242,122,26,.25);  color:#fef0e7; }
        .ibadge--sim     { background:rgba(125,141,184,.2);  color:#d0d8f0; }
    </style>
}

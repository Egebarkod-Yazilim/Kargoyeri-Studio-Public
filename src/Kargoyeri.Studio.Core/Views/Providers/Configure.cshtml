        "ptt"             => new("Musteri ID",              "Ornk: 12345",                            "Sayisal musteriId â€” PTT tarafindan atanir. Zorunlu."),
        "ups"             => new("Hesap Numarasi",          "UPS shipper account number",             "ShipperNumber: UPS portali > Hesabim > Hesap Numarayi"),
        "trendyolexpress" => new("Trendyol Satici ID",      "Ornk: 123456",                           "Trendyol Seller API'den alinan numerik satici ID'si."),
        "hepsijet"        => new("Client Code",             "HepsiJet tarafindan verilen",            "getToken cagrÄ±sÄ±nda clientCode parametresi olarak gonderilir."),
        "mng"             => new("Musteri Kodu",            "(MNG gerektirmiyorsa bos birakin)",      "MNG SOAP'ta kullanim durumuna gore opsiyoneldir.", Required: false),
        "aras"            => new("Musteri Kodu",            "(Aras gerektirmiyorsa bos birakin)",     "Aras SOAP'ta IntegrationCode olarak kullanilmaz; username/password yeterlidir.", Required: false),
        _                 => new("Musteri Kodu",            "Firma tarafindan verilen musteri kodu",  null)

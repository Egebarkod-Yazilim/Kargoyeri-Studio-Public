        "ptt"             => new("Kullanici",               "PTT servis kullanici adi",               "kabulEkle2 SOAP cagrÄ±sÄ±nda kullanici parametresi."),
        "trendyolexpress" => new("API Kullanici Adi",       "Trendyol partner portal username",       "Trendyol Seller API Basic Auth kullanici adi."),
        "hepsijet"        => new("Kullanici Adi",           "HepsiJet entegrasyon kullanici adi",     "getToken cagrÄ±sÄ±nda userName parametresi."),

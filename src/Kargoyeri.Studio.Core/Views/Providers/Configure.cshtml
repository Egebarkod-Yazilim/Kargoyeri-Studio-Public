        "ptt"             => new("Sifre",                   "PTT servis sifresi",                     "kabulEkle2 SOAP cagrÄ±sÄ±nda sifre parametresi."),
        "trendyolexpress" => new("API Sifresi",             "Trendyol partner portal password",       "Trendyol Seller API Basic Auth sifresi."),

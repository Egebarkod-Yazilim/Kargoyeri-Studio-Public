@{
    ViewData["Title"] = $"{Model.ProviderName} Ayarlari";
    int missingCount = Model.Status.MissingSettings.Count;
    int readinessPercent = Model.Status.CanCreateShipment
        ? 100
        : Math.Max(0, 100 - (missingCount * 25));
    bool isWarn = readinessPercent < 60;
    var ops = Model.Profile.SupportedOperations.ToList();
    var pcode = Model.ProviderCode;

    var fClientCode = ClientCodeMeta(pcode);
    var fUsername   = UsernameMeta(pcode);
    var fPassword   = PasswordMeta(pcode);
    var fApiKey     = ApiKeyMeta(pcode);
    var fEndpoint   = EndpointMeta(pcode);
    var hints       = AdditionalHints(pcode);
    var opFlow      = GetOpFlow(pcode);
}

@if (TempData["PingResult"] is string pingResult)
{
    <div class="flash @(pingResult == "ok" ? "" : "flash--warn")" style="margin-bottom:16px;">
        <strong>@(pingResult == "ok" ? "Baglanti Basarili" : "Baglanti Basarisiz")</strong> â€” @TempData["PingMessage"]
    </div>
}

@* Provider renkli banner *@
<div class="provider-config-banner @Model.Visual.AccentClass">
    <div>
        <p class="eyebrow">@Model.WorkspaceName &rsaquo; Kargo Firmalari</p>
        <h1>@Model.ProviderName</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Visual.Caption))
        {
            <p>@Model.Visual.Caption</p>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Visual.Headline))
        {
            <p>@Model.Visual.Headline</p>
        }
    </div>
    <div class="banner-stats">
        <div class="banner-stat-row">
            <span>Mod:</span>
            <strong>@Model.Status.IntegrationMode</strong>
        </div>
        <div class="banner-stat-row">
            <span>Canli API:</span>
            <strong>@(Model.Status.LiveTransportImplemented ? "Var" : "Yok")</strong>
        </div>
        <div class="banner-stat-row">
            <span>Durum:</span>
            <strong>@(Model.Status.CanCreateShipment ? "Hazir" : "Eksik Alan Var")</strong>
        </div>
        <form asp-action="Ping" asp-route-id="@Model.ProviderCode" method="post" class="ping-form" style="margin-top:10px;">
            <button class="secondary-button" type="submit" style="font-size:.82rem;padding:6px 14px;">
                Baglanti Test Et
            </button>
        </form>
    </div>
</div>

<div class="split-layout split-layout--wide">

    @* SOL: Ayar formu *@
    <section class="panel-card">
        <div class="section-heading section-heading--tight">
            <div>
                <p class="eyebrow">Kimlik ve Baglanti</p>
                <h2>API Ayarlari</h2>
            </div>
        </div>

        @* ── Stepper ────────────────────────────────────────────────── *@
        <div class="prov-wizard">
            <div class="prov-stepper" id="provStepper">
                <div class="prov-step is-active" data-step="1">
                    <span class="ps-num">1</span>
                    <div class="ps-text">
                        <strong>Aktivasyon</strong>
                        <span>Firmayı aç/kapat</span>
                    </div>
                </div>
                <div class="prov-step" data-step="2">
                    <span class="ps-num">2</span>
                    <div class="ps-text">
                        <strong>Kimlik Bilgileri</strong>
                        <span>Kullanıcı / şifre</span>
                    </div>
                </div>
                <div class="prov-step" data-step="3">
                    <span class="ps-num">3</span>
                    <div class="ps-text">
                        <strong>API Bağlantısı</strong>
                        <span>Anahtar / endpoint</span>
                    </div>
                </div>
                <div class="prov-step" data-step="4">
                    <span class="ps-num">4</span>
                    <div class="ps-text">
                        <strong>Ek Ayarlar & Kayıt</strong>
                        <span>Onay ve kaydet</span>
                    </div>
                </div>
            </div>

            <form asp-action="Configure" method="post" class="form-grid prov-form" id="provForm">
                <input asp-for="ProviderCode" type="hidden" />
                <input asp-for="ProviderName" type="hidden" />

                @* ── Adım 1: Aktivasyon ───────────────────────────── *@
                <div class="prov-pane is-active" data-pane="1">
                    <div class="prov-pane-head">
                        <h3>1. Bu firmayı aktif kullan</h3>
                        <p>Aktif olmayan firma üzerinden gönderi oluşturulamaz. İstediğiniz zaman kapatıp açabilirsiniz.</p>
                    </div>
                    <div class="toggle-row-v2">
                        <div>
                            <strong>@Model.ProviderName aktif</strong>
                            <p style="margin:3px 0 0;font-size:.85rem;color:var(--muted);">Kapalı firmanın gönderi oluşturması engellenir.</p>
                        </div>
                        <input asp-for="IsEnabled" type="checkbox" style="width:20px;height:20px;" />
                    </div>
                </div>

                @* ── Adım 2: Kimlik Bilgileri ──────────────────────── *@
                <div class="prov-pane" data-pane="2">
                    <div class="prov-pane-head">
                        <h3>2. Kimlik Bilgileri</h3>
                        <p>Bu firma sizi tanımak için aşağıdaki bilgileri kullanır.</p>
                    </div>

                    @if (!fClientCode.Hidden)
                    {
                        <label>
                            <span>
                                @fClientCode.Label
                                @if (fClientCode.Required) { <span class="field-required">zorunlu</span> }
                                else { <span class="field-optional">opsiyonel</span> }
                            </span>
                            <input asp-for="ClientCode" placeholder="@fClientCode.Placeholder" />
                            @if (!string.IsNullOrWhiteSpace(fClientCode.Hint))
                            {
                                <small class="field-hint">@fClientCode.Hint</small>
                            }
                        </label>
                    }

                    @if (!fUsername.Hidden)
                    {
                        <label>
                            <span>
                                @fUsername.Label
                                @if (fUsername.Required) { <span class="field-required">zorunlu</span> }
                                else { <span class="field-optional">opsiyonel</span> }
                            </span>
                            <input asp-for="Username" placeholder="@fUsername.Placeholder" />
                            @if (!string.IsNullOrWhiteSpace(fUsername.Hint))
                            {
                                <small class="field-hint">@fUsername.Hint</small>
                            }
                        </label>
                    }

                    @if (!fPassword.Hidden)
                    {
                        <label>
                            <span>
                                @fPassword.Label
                                @if (fPassword.Required) { <span class="field-required">zorunlu</span> }
                                else { <span class="field-optional">opsiyonel</span> }
                            </span>
                            <input asp-for="Password" type="password" autocomplete="new-password"
                                   placeholder="@(Model.HasStoredPassword ? "(kayıtlı — değiştirmek için yeni değer gir)" : fPassword.Placeholder)" />
                            @if (Model.HasStoredPassword)
                            {
                                <small class="field-hint" style="color:#16a34a;">&#10003; Şifre kayıtlı. Boş bırakırsan mevcut değer korunur.</small>
                            }
                            else if (!string.IsNullOrWhiteSpace(fPassword.Hint))
                            {
                                <small class="field-hint">@fPassword.Hint</small>
                            }
                        </label>
                    }

                    @if (fClientCode.Hidden && fUsername.Hidden && fPassword.Hidden)
                    {
                        <div class="prov-empty">
                            Bu firma kimlik bilgisi gerektirmiyor. Bir sonraki adıma geçebilirsiniz.
                        </div>
                    }
                </div>

                @* ── Adım 3: API Bağlantısı ────────────────────────── *@
                <div class="prov-pane" data-pane="3">
                    <div class="prov-pane-head">
                        <h3>3. API Bağlantısı</h3>
                        <p>Anahtar ve servis adresi. Çoğu firma için endpoint varsayılanı yeterlidir.</p>
                    </div>

                    @if (!fApiKey.Hidden)
                    {
                        <label>
                            <span>
                                @fApiKey.Label
                                @if (fApiKey.Required) { <span class="field-required">zorunlu</span> }
                                else { <span class="field-optional">opsiyonel</span> }
                            </span>
                            <input asp-for="ApiKey" type="password" autocomplete="new-password"
                                   placeholder="@(Model.HasStoredApiKey ? "(kayıtlı — değiştirmek için yeni değer gir)" : fApiKey.Placeholder)" />
                            @if (Model.HasStoredApiKey)
                            {
                                <small class="field-hint" style="color:#16a34a;">&#10003; API anahtarı kayıtlı. Boş bırakırsan mevcut değer korunur.</small>
                            }
                            else if (!string.IsNullOrWhiteSpace(fApiKey.Hint))
                            {
                                <small class="field-hint">@fApiKey.Hint</small>
                            }
                        </label>
                    }

                    <label>
                        <span>
                            @fEndpoint.Label
                            @if (fEndpoint.Required) { <span class="field-required">zorunlu</span> }
                            else { <span class="field-optional">opsiyonel</span> }
                        </span>
                        <input asp-for="EndpointBase" placeholder="@fEndpoint.Placeholder" />
                        @if (!string.IsNullOrWhiteSpace(fEndpoint.Hint))
                        {
                            <small class="field-hint">@fEndpoint.Hint</small>
                        }
                    </label>
                </div>

                @* ── Adım 4: Ek Ayarlar & Kayıt ────────────────────── *@
                <div class="prov-pane" data-pane="4">
                    <div class="prov-pane-head">
                        <h3>4. Ek Ayarlar &amp; Kayıt</h3>
                        <p>Firmaya özel ek parametreleri girip kaydedebilirsiniz. Sağdaki referans karttan kopyalayabilirsiniz.</p>
                    </div>

                    <label class="field-span">
                        <span>Ek Parametreler <span style="font-size:.8em;font-weight:400;color:var(--muted);">(key=value, her satıra bir tane)</span></span>
                        <textarea asp-for="AdditionalSettingsText" rows="5"
                                  placeholder="simulationMode=true&#10;warehouseCode=IST01"></textarea>
                        <small class="field-hint">
                            Sağdaki referans kartında bu firma için geçerli anahtarlar listelenmiştir.
                        </small>
                    </label>

                    <div class="prov-summary">
                        <div class="prov-summary-row"><span>Firma:</span><strong>@Model.ProviderName</strong></div>
                        <div class="prov-summary-row"><span>Hazırlık:</span><strong>%@readinessPercent</strong></div>
                        <div class="prov-summary-row"><span>Mod:</span><strong>@Model.Status.IntegrationMode</strong></div>
                        <div class="prov-summary-row"><span>Canlı API:</span><strong>@(Model.Status.LiveTransportImplemented ? "Var" : "Yok")</strong></div>
                    </div>
                </div>

                @* ── Wizard navigasyonu ───────────────────────────── *@
                <div class="prov-nav">
                    <button type="button" class="secondary-button" id="provBack" disabled>← Geri</button>
                    <span class="prov-progress" id="provProgress">Adım 1 / 4</span>
                    <button type="button" class="primary-button" id="provNext">İleri →</button>
                    <button type="submit" class="primary-button" id="provSave" style="display:none;">Kaydet</button>
                </div>

                <div class="action-row action-row--left" style="padding-top:6px;border-top:1px dashed var(--border);margin-top:8px;">
                    <a class="ghost-link" asp-controller="Providers" asp-action="Index">Firmalara Dön</a>
                    @if (Model.Status.CanCreateShipment)
                    {
                        <a class="ghost-link" asp-controller="Shipments" asp-action="Index">Gönderilere Git</a>
                    }
                </div>
            </form>
        </div>
    </section>

    @* SAG: Durum + Referans kartlari *@
    <aside style="display:flex;flex-direction:column;gap:16px;">

        @* Entegrasyon Akisi â€” endpoint + implementasyon durumu *@
        <section class="panel-card">
            <p class="eyebrow">Entegrasyon Akisi</p>
            <p style="font-size:.82rem;color:var(--muted);margin:4px 0 14px;">
                Bu firma ile hangi operasyonlar, hangi endpoint'ler uzerinden calisir.
            </p>
            <div class="op-flow-list">
                @foreach (var op in opFlow)
                {
                    <div class="op-flow-row @op.ImplCss">
                        <div class="op-flow-left">
                            <span class="op-method @op.MethodCss">@op.MethodBadge</span>
                            <div class="op-flow-info">
                                <strong class="op-name">@op.Name</strong>
                                <code class="op-endpoint">@op.EndpointShort</code>
                                @if (!string.IsNullOrWhiteSpace(op.Note))
                                {
                                    <span class="op-note">@op.Note</span>
                                }
                            </div>
                        </div>
                        <span class="op-impl-badge @op.ImplCss">@op.ImplBadge</span>
                    </div>
                }
            </div>
        </section>

        @* Hazirlik gostergesi *@
        <section class="panel-card">
            <p class="eyebrow">Hazirlik Durumu</p>
            <div class="readiness-wrap" style="margin-top:10px;">
                <div class="readiness-top">
                    <span style="font-size:.88rem;color:var(--muted);">
                        @(Model.Status.CanCreateShipment ? "Gonderi olusturmaya hazir" : $"{missingCount} eksik alan kaldi")
                    </span>
                    <span class="readiness-pct">%@readinessPercent</span>
                </div>
                <div class="readiness-bar">
                    <div class="readiness-fill @(isWarn ? "readiness-fill--warn" : "")"
                         style="width:@readinessPercent%"></div>
                </div>
            </div>

            @if (missingCount > 0)
            {
                <div class="missing-list">
                    @foreach (var missing in Model.Status.MissingSettings)
                    {
                        <div class="missing-item">@missing</div>
                    }
                </div>
            }
            else
            {
                <p style="font-size:.88rem;color:var(--secondary);margin:8px 0 0;">
                    &#10003; Tum gerekli alanlar dolu. Bu firma gonderi olusturabilir.
                </p>
            }
        </section>

        @* Ek Ayarlar Referans Karti *@
        @if (hints.Count > 0)
        {
            <section class="panel-card">
                <p class="eyebrow">Ek Ayarlar Referansi</p>
                <p style="font-size:.82rem;color:var(--muted);margin:6px 0 12px;">
                    Sol taraftaki <strong>Ek Parametreler</strong> alanina asagidaki anahtarlari girebilirsiniz.
                </p>
                <div class="settings-hint-list">
                    @foreach (var hint in hints)
                    {
                        <div class="settings-hint-item">
                            <div class="settings-hint-key">
                                <code>@hint.Key</code>
                                @if (hint.Required) { <span class="field-required" style="font-size:.72rem;">zorunlu</span> }
                            </div>
                            <div class="settings-hint-desc">@hint.Desc</div>
                            <div class="settings-hint-example">
                                <button type="button" class="copy-hint-btn"
                                        data-value="@hint.Key=">
                                    Kopyala
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @* Desteklenen islemler *@
        @if (ops.Count > 0)
        {
            <section class="panel-card">
                <p class="eyebrow">Desteklenen Islemler</p>
                <p style="font-size:.85rem;color:var(--muted);margin:6px 0 10px;">
                    Bu entegrasyon @ops.Count islem destekliyor.
                </p>
                <div class="cap-list">
                    @foreach (var op in ops)
                    {
                        <span class="cap-tag">@OpLabel(op)</span>
                    }
                </div>
            </section>
        }

        @* Studio islem rotalari *@
        <section class="panel-card panel-card--dim">
            <p class="eyebrow">İşlem Rotaları</p>
            <p style="font-size:.82rem;color:var(--muted);margin:6px 0 10px;">
                Bu ekranlar veya dis sistemler asagidaki rotalari kullanarak islem tetikleyebilir.
            </p>
            <div class="api-route-list">
                <div class="api-route">
                    <span class="api-method api-method--get">GET</span>
                    <span class="api-path">/providers/configure/@Model.ProviderCode</span>
                    <span class="api-desc">Ayarlari goster</span>
                </div>
                <div class="api-route">
                    <span class="api-method api-method--post">POST</span>
                    <span class="api-path">/providers/configure</span>
                    <span class="api-desc">Ayarlari kaydet</span>
                </div>
                <div class="api-route">
                    <span class="api-method api-method--get">GET</span>
                    <span class="api-path">/shipments</span>
                    <span class="api-desc">Gonderi listesi</span>
                </div>
                <div class="api-route">
                    <span class="api-method api-method--get">GET</span>
                    <span class="api-path">/shipments/detail?shipmentReference=&#123;ref&#125;</span>
                    <span class="api-desc">Gonderi detayi</span>
                </div>
                <div class="api-route">
                    <span class="api-method api-method--post">POST</span>
                    <span class="api-path">/shipments/refresh</span>
                    <span class="api-desc">Durum guncelle</span>
                </div>
                <div class="api-route">
                    <span class="api-method api-method--post">POST</span>
                    <span class="api-path">/shipments/cancel</span>
                    <span class="api-desc">Gonderi iptal</span>
                </div>
            </div>
        </section>

    </aside>
</div>

@section Scripts {
    <style>
        /* ── Wizard ──────────────────────────────────────────────── */
        .prov-wizard { display:flex; flex-direction:column; gap:18px; }
        .prov-stepper {
            display:grid;
            grid-template-columns:repeat(4, 1fr);
            gap:8px;
            padding:14px;
            border-radius:10px;
            background:rgba(107,156,248,.04);
            border:1px solid var(--border);
        }
        .prov-step {
            display:flex; align-items:center; gap:10px;
            padding:10px 12px;
            border-radius:8px;
            border:1px solid transparent;
            background:rgba(125,141,184,.05);
            position:relative;
            transition:background .18s, border-color .18s, transform .18s;
            cursor:default;
        }
        .prov-step + .prov-step::before {
            content:"›";
            position:absolute; left:-10px; top:50%;
            transform:translateY(-50%);
            color:var(--muted); font-size:1.1rem; opacity:.6;
        }
        .prov-step.is-active {
            background:rgba(107,156,248,.12);
            border-color:rgba(107,156,248,.4);
        }
        .prov-step.is-done {
            background:rgba(39,174,96,.08);
            border-color:rgba(39,174,96,.25);
        }
        .ps-num {
            width:30px; height:30px; flex-shrink:0;
            border-radius:50%;
            background:var(--border);
            color:var(--muted);
            display:flex; align-items:center; justify-content:center;
            font-weight:700; font-size:.92rem;
        }
        .prov-step.is-active .ps-num { background:#6b9cf8; color:#fff; }
        .prov-step.is-done .ps-num { background:#27ae60; color:#fff; font-size:0; }
        .prov-step.is-done .ps-num::before { content:"✓"; font-size:.9rem; font-weight:700; }
        .ps-text { display:flex; flex-direction:column; line-height:1.2; min-width:0; }
        .ps-text strong { font-size:.86rem; color:var(--text); }
        .ps-text span { font-size:.74rem; color:var(--muted); }

        .prov-pane { display:none; animation:provFade .22s ease-out; }
        .prov-pane.is-active { display:flex; flex-direction:column; gap:14px; }
        @@keyframes provFade {
            from { opacity:0; transform:translateY(4px); }
            to   { opacity:1; transform:translateY(0); }
        }
        .prov-pane-head h3 { margin:0 0 4px; font-size:1.05rem; }
        .prov-pane-head p { margin:0; font-size:.86rem; color:var(--muted); }

        .prov-empty {
            padding:14px; border-radius:8px;
            background:rgba(125,141,184,.06);
            border:1px dashed var(--border);
            color:var(--muted); font-size:.88rem;
        }

        .prov-summary {
            display:grid; grid-template-columns:repeat(2,1fr); gap:8px 16px;
            padding:12px 14px; border-radius:8px;
            background:rgba(39,174,96,.05);
            border:1px solid rgba(39,174,96,.2);
        }
        .prov-summary-row { display:flex; justify-content:space-between; gap:10px; font-size:.86rem; }
        .prov-summary-row span { color:var(--muted); }

        .prov-nav {
            display:flex; align-items:center; gap:10px;
            padding-top:10px;
            border-top:1px solid var(--border);
        }
        .prov-nav .prov-progress { margin-left:auto; margin-right:6px; font-size:.82rem; color:var(--muted); }

        @@media (max-width: 720px) {
            .prov-stepper { grid-template-columns:repeat(2, 1fr); }
            .prov-step + .prov-step::before { display:none; }
        }

        /* ── Entegrasyon Akisi â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        .op-flow-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .op-flow-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: rgba(107,156,248,.03);
        }
        .op-flow-row.imp-none {
            background: rgba(203,92,45,.04);
            border-color: rgba(203,92,45,.2);
            opacity: .8;
        }
        .op-flow-row.imp-sim {
            background: rgba(125,141,184,.04);
            border-color: rgba(125,141,184,.18);
        }
        .op-flow-row.imp-auto {
            background: rgba(39,174,96,.04);
            border-color: rgba(39,174,96,.2);
        }
        .op-flow-left {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            flex: 1;
            min-width: 0;
        }
        .op-method {
            display: inline-block;
            font-size: .68rem;
            font-weight: 700;
            padding: 3px 6px;
            border-radius: 4px;
            white-space: nowrap;
            flex-shrink: 0;
            margin-top: 2px;
            font-family: monospace;
        }
        .mth-post   { background: rgba(52,152,219,.15); color:#4a9fd5; }
        .mth-get    { background: rgba(39,174,96,.15);  color:#27ae60; }
        .mth-put    { background: rgba(155,89,182,.15); color:#9b59b6; }
        .mth-delete { background: rgba(203,92,45,.15);  color:#e05c4e; }
        .mth-soap   { background: rgba(212,160,23,.15); color:#d4a017; }
        .mth-sim    { background: rgba(125,141,184,.12);color:#7d8db8; }
        .mth-none   { background: rgba(203,92,45,.1);   color:#e05c4e; }
        .op-flow-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }
        .op-name {
            font-size: .85rem;
            color: var(--text);
            font-weight: 600;
        }
        .op-endpoint {
            font-size: .75rem;
            color: var(--muted);
            font-family: monospace;
            word-break: break-all;
        }
        .op-note {
            font-size: .76rem;
            color: var(--muted);
            line-height: 1.4;
            margin-top: 2px;
        }
        .imp-none .op-note { color: #e8a45a; }
        .op-impl-badge {
            display: inline-block;
            font-size: .72rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 20px;
            white-space: nowrap;
            flex-shrink: 0;
            align-self: flex-start;
        }
        .op-impl-badge.imp-live {
            background: rgba(39,174,96,.12);
            color: #27ae60;
            border: 1px solid rgba(39,174,96,.3);
        }
        .op-impl-badge.imp-sim {
            background: rgba(125,141,184,.12);
            color: #7d8db8;
            border: 1px solid rgba(125,141,184,.25);
        }
        .op-impl-badge.imp-none {
            background: rgba(203,92,45,.1);
            color: #e05c4e;
            border: 1px solid rgba(203,92,45,.25);
        }
        .op-impl-badge.imp-auto {
            background: rgba(39,174,96,.08);
            color: #27ae60;
            border: 1px solid rgba(39,174,96,.2);
        }

        /* â”€â”€ Settings Hint â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        .settings-hint-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .settings-hint-item {
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-rows: auto auto;
            gap: 2px 8px;
            padding: 10px 12px;
            border-radius: 7px;
            background: rgba(107,156,248,.04);
            border: 1px solid var(--border);
        }
        .settings-hint-key {
            grid-column: 1;
            grid-row: 1;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .settings-hint-key code {
            font-family: monospace;
            font-size: .84rem;
            color: #6b9cf8;
            background: rgba(107,156,248,.1);
            padding: 2px 6px;
            border-radius: 4px;
        }
        .settings-hint-desc {
            grid-column: 1;
            grid-row: 2;
            font-size: .8rem;
            color: var(--muted);
        }
        .settings-hint-example {
            grid-column: 2;
            grid-row: 1 / 3;
            display: flex;
            align-items: center;
        }
        .copy-hint-btn {
            background: none;
            border: 1px solid var(--border);
            color: var(--muted);
            font-size: .74rem;
            padding: 3px 8px;
            border-radius: 5px;
            cursor: pointer;
            transition: color .15s, border-color .15s;
            white-space: nowrap;
        }
        .copy-hint-btn:hover {
            color: #6b9cf8;
            border-color: #6b9cf8;
        }
        .copy-hint-btn.copied {
            color: #27ae60;
            border-color: #27ae60;
        }
        .field-hint {
            display: block;
            margin-top: 4px;
            font-size: .78rem;
            color: var(--muted);
            line-height: 1.4;
        }
        .field-optional {
            font-size: .75rem;
            color: var(--muted);
            font-weight: 400;
            margin-left: 4px;
        }
        .field-required {
            font-size: .75rem;
            color: #e8a45a;
            font-weight: 600;
            margin-left: 4px;
        }
    </style>
    <script>
    // ── Provider wizard ─────────────────────────────────────────
    (function () {
        var TOTAL = 4;
        var current = 1;

        // Akıllı başlangıç: hangi alanlar dolu, oradan devam et
        try {
            var f = document.getElementById('provForm');
            if (f) {
                var hasCreds =
                    (f.querySelector('[name="ClientCode"]') && f.querySelector('[name="ClientCode"]').value.trim()) ||
                    (f.querySelector('[name="Username"]') && f.querySelector('[name="Username"]').value.trim()) ||
                    @(Model.HasStoredPassword ? "true" : "false");
                var hasApi =
                    (f.querySelector('[name="EndpointBase"]') && f.querySelector('[name="EndpointBase"]').value.trim()) ||
                    @(Model.HasStoredApiKey ? "true" : "false");
                if (hasCreds && hasApi) current = 4;
                else if (hasCreds) current = 3;
                else if (@(Model.IsEnabled ? "true" : "false")) current = 2;
            }
        } catch (e) { /* yoksay */ }

        var steps = document.querySelectorAll('#provStepper .prov-step');
        var panes = document.querySelectorAll('.prov-pane');
        var btnBack = document.getElementById('provBack');
        var btnNext = document.getElementById('provNext');
        var btnSave = document.getElementById('provSave');
        var prog    = document.getElementById('provProgress');

        function render() {
            steps.forEach(function (s) {
                var n = parseInt(s.getAttribute('data-step'), 10);
                s.classList.remove('is-active','is-done');
                if (n < current) s.classList.add('is-done');
                else if (n === current) s.classList.add('is-active');
            });
            panes.forEach(function (p) {
                p.classList.toggle('is-active', parseInt(p.getAttribute('data-pane'),10) === current);
            });
            btnBack.disabled = (current === 1);
            if (current === TOTAL) {
                btnNext.style.display = 'none';
                btnSave.style.display = '';
            } else {
                btnNext.style.display = '';
                btnSave.style.display = 'none';
            }
            prog.textContent = 'Adım ' + current + ' / ' + TOTAL;
        }

        function validateStep(n) {
            // Tarayıcı HTML5 validasyonu — required alanlar için
            var pane = document.querySelector('.prov-pane[data-pane="' + n + '"]');
            if (!pane) return true;
            var inputs = pane.querySelectorAll('input, textarea, select');
            for (var i = 0; i < inputs.length; i++) {
                if (!inputs[i].checkValidity()) {
                    inputs[i].reportValidity();
                    return false;
                }
            }
            return true;
        }

        btnNext.addEventListener('click', function () {
            if (!validateStep(current)) return;
            if (current < TOTAL) { current++; render(); }
        });
        btnBack.addEventListener('click', function () {
            if (current > 1) { current--; render(); }
        });

        // Stepper'a tıklayınca o adıma git (geri için her zaman, ileri için validasyonla)
        steps.forEach(function (s) {
            s.style.cursor = 'pointer';
            s.addEventListener('click', function () {
                var target = parseInt(s.getAttribute('data-step'), 10);
                if (target <= current) { current = target; render(); return; }
                // ileriye doğru — aradaki adımları doğrula
                for (var k = current; k < target; k++) {
                    if (!validateStep(k)) return;
                }
                current = target;
                render();
            });
        });

        render();
    }());

    (function () {
        // "Kopyala" dugmeleri â€” key=value'yi textarea'ya ekle
        var textarea = document.querySelector('textarea[name="AdditionalSettingsText"]');
        document.querySelectorAll('.copy-hint-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var value = btn.getAttribute('data-value');
                if (!textarea) { return; }
                var current = textarea.value.trimEnd();
                // Zaten var mi?
                var key = value.split('=')[0];
                var lines = current.split('\n').map(function(l){ return l.trim(); });
                var existing = lines.find(function(l){ return l.startsWith(key + '='); });
                if (!existing) {
                    textarea.value = current ? current + '\n' + value : value;
                    textarea.focus();
                    // Sona git
                    textarea.setSelectionRange(textarea.value.length, textarea.value.length);
                }
                btn.textContent = 'Eklendi';
                btn.classList.add('copied');
                setTimeout(function () {
                    btn.textContent = 'Kopyala';
                    btn.classList.remove('copied');
                }, 1800);
            });
        });
    }());
    </script>
}

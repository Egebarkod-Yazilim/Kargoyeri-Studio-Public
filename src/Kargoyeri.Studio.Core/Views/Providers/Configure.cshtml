        "aras"            => new("", "", "", Required: false, Hidden: true),
        "hepsijet"        => new("", "", "", Required: false, Hidden: true),
        "trendyolexpress" => new("", "", "", Required: false, Hidden: true),
        _                 => new("API Key",                 "API anahtari veya token",                null)
    };

    static FieldMeta EndpointMeta(string providerCode) => providerCode.ToLower() switch
    {
        "surat"           => new("API Adresi",  "https://api02.suratkargo.com.tr",            "REST test: api02 | REST canli: api01 | SOAP test: https://prova.suratkargo.com.tr/services.asmx | SOAP canli: https://webservices.suratkargo.com.tr/services.asmx", Required: false),
        "hepsijet"        => new("API Adresi",  "https://integration-api.hepsijet.com",       "Test: integration-apitest.hepsijet.com | Prod: integration-api.hepsijet.com", Required: false),
        "mng"             => new("SOAP Adresi", "http://service.mngkargo.com.tr/...",         "Varsayilan SOAP URL icsel tanimlidir; degistirmek icin bos birakin.", Required: false),
        "aras"            => new("SOAP Adresi", "https://customerservicestest.araskargo.com.tr/...", "Test: customerservicestest | Prod: customerservices URL'ini girin.", Required: false),
        "ups"             => new("API Adresi",  "https://onlinetools.ups.com",                "Varsayilan: onlinetools.ups.com â€” CTE (test) icin wwwcie.ups.com.", Required: false),
        "ptt"             => new("SOAP Adresi", "http://pttws.ptt.gov.tr/...",                "Varsayilan PTT SOAP endpoint icsel tanimlidir; bos birakin.", Required: false),
        "trendyolexpress" => new("API Adresi",  "https://api.trendyol.com",                   "Varsayilan: api.trendyol.com â€” degistirmeye gerek yok.", Required: false),
        _                 => new("Servis Adresi", "ornek: https://api.firma.com.tr/v2",       null, Required: false)

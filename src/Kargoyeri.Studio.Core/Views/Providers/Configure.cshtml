    // â”€â”€ Desteklenen islem etiketi â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    static string OpLabel(string op) => op switch
    {
        "CreateShipment"     => "Gonderi Olustur",
        "TrackShipment"      => "Kargo Takip",
        "CancelShipment"     => "Iptal Et",
        "GetLabel"           => "Barkod / Etiket",
        "GetBranches"        => "Sube Listesi",
        "GetCities"          => "Sehir Listesi",

        {
            new("Gonderi Olustur", "â€”",      "mth-sim",   "Simulasyon",                                      "Simulasyon",     "imp-sim"),
            new("Iptal Et",        "â€”",      "mth-sim",   "Simulasyon",                                      "Simulasyon",     "imp-sim"),

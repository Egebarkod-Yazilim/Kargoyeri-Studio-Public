            new("Iptal Et",        "DELETE", "mth-delete","onlinetools.ups.com â€º /api/.../void/cancel/{id}", "Canli",          "imp-live"),
            new("Durum Sorgula",   "GET",    "mth-get",   "onlinetools.ups.com â€º /api/track/v1/details/{no}","Canli",          "imp-live"),
        },
        "trendyolexpress" => new OpFlow[]
        {
            new("Depo Ata",        "PUT",    "mth-put",   "api.trendyol.com â€º orders/{id}/update-warehouse-information", "Canli", "imp-live", "Klasik gonderi degil; Trendyol siparisine depo atar."),
            new("Iptal Et",        "â€”",      "mth-none",  "Desteklenmiyor",                                  "Desteklenmez",   "imp-none", "Trendyol siparisleri Satis Paneli uzerinden iptal edilir."),

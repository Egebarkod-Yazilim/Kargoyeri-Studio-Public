@model ProviderSettingsEditorViewModel
@functions {

    // â”€â”€ Entegrasyon Akisi â€” her provider'a ozel endpoint listesi â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    record OpFlow(
        string Name,
        string MethodBadge,
        string MethodCss,
        string EndpointShort,
        string ImplBadge,
        string ImplCss,
        string? Note = null);

    static IReadOnlyList<OpFlow> GetOpFlow(string pcode) => pcode.ToLower() switch
    {
        "surat" => new OpFlow[]
        {
            new("Gonderi Olustur", "POST",   "mth-post",  "api02/api01 › GonderiBarkodOlustur veya SOAP GonderiyiKargoyaGonderYeni", "Canli", "imp-live"),
            new("Iptal Et",        "POST",   "mth-post",  "suratkargo.com.tr › GonderiSil",                  "Canli",          "imp-live"),
            new("Durum Sorgula",   "POST",   "mth-post",  "api › KargoTakipHareketDetayi (CariKodu, Sifre, WebSiparisKodu)", "Canli", "imp-live"),
        },
        "hepsijet" => new OpFlow[]
        {
            new("Token Al",        "GET",    "mth-get",   "hepsijet.com â€º /auth/getToken",                   "Otomatik",       "imp-auto", "Her gonderi isleminden once X-Auth-Token alinir."),
            new("Gonderi Olustur", "POST",   "mth-post",  "hepsijet.com â€º sendDeliveryOrderEnhanced",        "Canli",          "imp-live"),

@model BulkShipmentPageViewModel
@{
    ViewData["Title"] = "Toplu Gonderi (CSV)";
    string StatePill(Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState s) => s switch
    {
        Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Completed => "success",
        Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Running   => "info",
        Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Failed    => "danger",
        _ => "neutral"
    };
}

<section class="panel-card" style="max-width:1080px;">
    <p class="eyebrow">@Model.TenantKey</p>
    <h1 style="margin:6px 0 8px;">Toplu Gonderi Yukleme (CSV)</h1>
    <p class="provider-index-note">
        CSV dosyasini yukleyin — sistem her satiri bir gonderi olarak kuyruga alir,
        arka planda kargo firmasi entegrasyonu uzerinden olusturur.
        Maks dosya boyutu <strong>5 MB</strong>.
    </p>

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="form-grid"
          style="margin-top:16px;display:flex;gap:10px;align-items:flex-end;">
        @Html.AntiForgeryToken()
        <label style="flex:1;">
            <span>CSV Dosyasi</span>
            <input type="file" name="file" accept=".csv" required
                   style="padding:8px;border:1px dashed #cbd5e1;border-radius:8px;background:#fff;" />
        </label>
        <button class="primary-button" type="submit">Yukle ve Baslat</button>
    </form>

    <details style="margin:18px 0;">
        <summary style="cursor:pointer;font-size:.9rem;color:#475569;">
            Beklenen CSV format ornegi (sutun basliklari)
        </summary>
        <pre style="margin:8px 0 0;font-size:11px;background:#0f172a;color:#e2e8f0;padding:12px;border-radius:6px;overflow-x:auto;">
orderReference,provider,recipientName,recipientPhone,recipientCity,recipientAddress,collectionAmount,packageWeightKg
ORD-001,Aras,Ahmet Yilmaz,5551112233,Istanbul,Kadikoy/Caddebostan...,0,1.5
ORD-002,Mng,Ayse Demir,5552223344,Ankara,Cankaya/Bahcelievler...,250.50,2.0
        </pre>
    </details>

    <h2 style="font-size:1.05rem;margin:24px 0 6px;">Son Job'lar</h2>
    @if (Model.Jobs.Count == 0)
    {
        <p style="color:#94a3b8;font-size:.9rem;">Henuz import calismasi yok.</p>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;margin-top:8px;">
            <thead>
                <tr style="background:#f1f5f9;">
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Dosya</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Durum</th>
                    <th style="text-align:right;padding:10px;border:1px solid #e2e8f0;">Toplam</th>
                    <th style="text-align:right;padding:10px;border:1px solid #e2e8f0;">Basari</th>
                    <th style="text-align:right;padding:10px;border:1px solid #e2e8f0;">Hata</th>
                    <th style="text-align:right;padding:10px;border:1px solid #e2e8f0;">Ilerleme</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Baslangic</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model.Jobs)
                {
                    <tr data-job-id="@j.Id" data-job-state="@j.State">
                        <td style="padding:10px;border:1px solid #e2e8f0;">
                            <a asp-action="Status" asp-route-id="@j.Id" target="_blank"
                               style="font-family:monospace;font-size:.85rem;">@j.FileName</a>
                            <br/><small style="color:#94a3b8;font-size:.7rem;">#@j.Id.ToString()[..8]</small>
                        </td>
                        <td style="padding:10px;border:1px solid #e2e8f0;">
                            <span class="badge @StatePill(j.State)">@j.State</span>
                            @if (!string.IsNullOrWhiteSpace(j.FatalError))
                            {
                                <br/><small style="color:#dc2626;">@j.FatalError</small>
                            }
                        </td>
                        <td style="padding:10px;border:1px solid #e2e8f0;text-align:right;">@j.TotalRows</td>
                        <td style="padding:10px;border:1px solid #e2e8f0;text-align:right;color:#16a34a;">@j.SuccessCount</td>
                        <td style="padding:10px;border:1px solid #e2e8f0;text-align:right;color:@(j.FailedCount > 0 ? "#dc2626" : "#94a3b8");">@j.FailedCount</td>
                        <td style="padding:10px;border:1px solid #e2e8f0;text-align:right;">
                            <div style="background:#e2e8f0;border-radius:99px;height:8px;width:120px;display:inline-block;overflow:hidden;">
                                <div class="job-progress" style="background:#16a34a;height:100%;width:@(j.ProgressPercent)%;transition:width .3s;"></div>
                            </div>
                            <br/><small>@j.ProgressPercent%</small>
                        </td>
                        <td style="padding:10px;border:1px solid #e2e8f0;font-size:.82rem;color:#64748b;">
                            @j.EnqueuedAtUtc.ToLocalTime().ToString("dd.MM HH:mm:ss")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@section Scripts {
<script>
    // Calismakta olan job'larin durumunu 3 sn'de bir polla
    (function () {
        const rows = document.querySelectorAll('tr[data-job-id][data-job-state="Running"], tr[data-job-id][data-job-state="Queued"]');
        if (!rows.length) return;
        rows.forEach(function (row) {
            const id = row.getAttribute('data-job-id');
            const tick = function () {
                fetch('/bulk/status/' + id).then(r => r.json()).then(j => {
                    const cells = row.querySelectorAll('td');
                    cells[2].innerText = j.total;
                    cells[3].innerText = j.success;
                    cells[4].innerText = j.failed;
                    const bar = row.querySelector('.job-progress');
                    if (bar) bar.style.width = j.progress + '%';
                    if (j.state !== 'Running' && j.state !== 'Queued') {
                        location.reload();
                    } else {
                        setTimeout(tick, 3000);
                    }
                }).catch(() => setTimeout(tick, 5000));
            };
            setTimeout(tick, 3000);
        });
    })();
</script>
}

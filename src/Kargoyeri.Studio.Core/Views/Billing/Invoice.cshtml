@model Kargoyeri.Studio.Core.Infrastructure.TenantInvoice
@{
    var tier = (Kargoyeri.Studio.Core.Infrastructure.BillingTier)ViewData["Tier"]!;
}

<style>
    .invoice {
        max-width:780px; margin:0 auto; background:var(--surface);
        border:1px solid var(--border); border-radius:14px; padding:36px 40px;
        box-shadow:0 6px 22px rgba(15,23,42,.05);
    }
    .invoice-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:28px; padding-bottom:20px; border-bottom:2px solid var(--border); }
    .invoice-title { font-size:1.4rem; margin:0 0 4px; }
    .invoice-num { font-size:.78rem; color:var(--muted); font-family:ui-monospace,monospace; }
    .invoice-meta { text-align:right; font-size:.84rem; color:var(--muted); }
    .invoice-meta strong { color:var(--text); display:block; font-size:1rem; }
    .invoice-section { margin:18px 0; }
    .invoice-section h4 { font-size:.78rem; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); margin:0 0 8px; }
    .invoice-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; font-size:.92rem; }
    .invoice-grid .v { font-weight:600; }
    .line-table { width:100%; border-collapse:collapse; margin-top:10px; font-size:.92rem; }
    .line-table th, .line-table td { padding:10px 8px; text-align:left; border-bottom:1px solid var(--border); }
    .line-table th { background:var(--panel-dim); font-size:.78rem; text-transform:uppercase; color:var(--muted); }
    .line-table td.num, .line-table th.num { text-align:right; }
    .totals { margin-top:18px; margin-left:auto; max-width:320px; font-size:.92rem; }
    .totals .row { display:flex; justify-content:space-between; padding:6px 0; }
    .totals .row.grand { border-top:2px solid var(--text); margin-top:8px; padding-top:10px; font-size:1.1rem; font-weight:700; }
    @@media print {
        body { background:#fff; }
        .topbar, .sidebar, .mobile-nav-toggle, .toast-container, .cmd-modal { display:none !important; }
        .content { padding:0 !important; }
        .invoice { box-shadow:none; border:none; }
    }
</style>

<div class="invoice">
    <div class="invoice-header">
        <div>
            <h1 class="invoice-title">Fatura</h1>
            <div class="invoice-num">No: @Model.InvoiceNumber</div>
        </div>
        <div class="invoice-meta">
            <strong>Kargoyeri</strong>
            Donem: @Model.PeriodFrom.ToString("dd.MM.yyyy") - @Model.PeriodTo.ToString("dd.MM.yyyy")<br />
            Duzenlenme: @Model.IssuedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>

    <div class="invoice-section">
        <h4>Musteri</h4>
        <div class="invoice-grid">
            <span>Tenant adi:</span><span class="v">@Model.TenantName</span>
            <span>Tenant kodu:</span><span class="v" style="font-family:ui-monospace,monospace;">@Model.TenantKey</span>
        </div>
    </div>

    <div class="invoice-section">
        <h4>Kullanim ozeti</h4>
        <table class="line-table">
            <thead>
                <tr>
                    <th>Kalem</th>
                    <th class="num">Adet</th>
                    <th class="num">Birim</th>
                    <th class="num">Tutar</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Aylik baz ucret (@Model.IncludedShipments gonderi dahil)</td>
                    <td class="num">1</td>
                    <td class="num">@Model.BaseFee.ToString("N2") @Model.Currency</td>
                    <td class="num">@Model.BaseFee.ToString("N2")</td>
                </tr>
                <tr>
                    <td>Asim gonderiler (@Model.ShipmentsCreated olusan - @Model.IncludedShipments dahil)</td>
                    <td class="num">@Model.ExtraShipments</td>
                    <td class="num">@tier.PricePerExtraShipment.ToString("N2") @Model.Currency</td>
                    <td class="num">@Model.ExtraFee.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="totals">
        <div class="row"><span>Subtotal:</span><span>@Model.Subtotal.ToString("N2") @Model.Currency</span></div>
        <div class="row"><span>KDV (@tier.VatPercent.ToString("N0")%):</span><span>@Model.Vat.ToString("N2") @Model.Currency</span></div>
        <div class="row grand"><span>Toplam:</span><span>@Model.Total.ToString("N2") @Model.Currency</span></div>
    </div>

    <div class="invoice-section" style="margin-top:30px;font-size:.78rem;color:var(--muted);">
        Bu belge bilgi amaclidir. Resmi fatura, mali muhasebe sisteminde duzenlenir.
        @Model.ShipmentsDelivered gonderi bu donemde teslim edildi.
    </div>

    <div style="margin-top:18px;text-align:right;">
        <button class="primary-btn" type="button" onclick="window.print();">Yazdir / PDF</button>
    </div>
</div>

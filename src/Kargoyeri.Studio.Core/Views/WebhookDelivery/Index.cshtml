@model WebhookDeliveryPageViewModel
@{
    ViewData["Title"] = "Webhook Teslimat Panosu";
    string StatusBadge(Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto s) => s switch
    {
        Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Delivered => "success",
        Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Queued    => "info",
        Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Failed    => "danger",
        _                                                                 => "warning"
    };
}

<section class="panel-card" style="max-width:1200px;">
    <p class="eyebrow">@Model.TenantName</p>
    <h1 style="margin:6px 0 8px;">Webhook Teslimat Panosu</h1>
    <p class="provider-index-note">
        Outbound webhook bildirimlerinin gonderim durumu ve otomatik retry kuyrugu (P2-#3).
        Schedule: 1 dk &middot; 5 dk &middot; 15 dk &middot; 1 sa &middot; 6 sa &middot; 24 sa &mdash; 6 deneme sonrasi terkedilir.
    </p>

    @if (TempData["StudioMessage"] is string msg)
    {
        <div class="kvkk-note" style="background:#ecfdf5;border-color:#10b981;color:#065f46;margin:12px 0;">@msg</div>
    }

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:14px 0 18px;">
        <div class="metric-card"><div class="metric-label">Toplam</div><div class="metric-value">@Model.TotalCount</div></div>
        <div class="metric-card"><div class="metric-label">Teslim Edilen</div><div class="metric-value" style="color:#16a34a;">@Model.DeliveredCount</div></div>
        <div class="metric-card"><div class="metric-label">Sirada</div><div class="metric-value" style="color:#0284c7;">@Model.QueuedCount</div></div>
        <div class="metric-card"><div class="metric-label">Basarisiz</div><div class="metric-value" style="color:#dc2626;">@Model.FailedCount</div></div>
        <div class="metric-card"><div class="metric-label">Retry Bekleyen</div><div class="metric-value" style="color:#ea580c;">@Model.RetryPendingCount</div></div>
        <div class="metric-card"><div class="metric-label">Terkedilen</div><div class="metric-value" style="color:#7c2d12;">@Model.AbandonedCount</div></div>
    </div>

    @if (Model.Recent.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#128231;</div>
            <h2>Webhook bildirimi yok</h2>
            <p>Bu workspace icin henuz outbound webhook gonderilmedi.</p>
        </div>
    }
    else
    {
        <div class="table-shell" style="overflow-x:auto;">
            <table class="studio-table" style="min-width:1100px;">
                <thead>
                    <tr>
                        <th>Olay</th>
                        <th>Gonderi</th>
                        <th>Hedef</th>
                        <th>@L["Label_Status"]</th>
                        <th>Olusturuldu</th>
                        <th style="text-align:center;">Deneme</th>
                        <th>Sonraki</th>
                        <th>Hata</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Recent)
                    {
                        <tr>
                            <td style="font-size:.82rem;"><span class="cap-tag">@r.EventType</span></td>
                            <td style="font-size:.85rem;">@r.ShipmentReference</td>
                            <td style="font-size:.78rem;color:#475569;max-width:240px;word-break:break-all;">@r.Address</td>
                            <td><span class="status-pill status-pill--@StatusBadge(r.Status)">@r.Status</span></td>
                            <td style="font-size:.78rem;color:#64748b;">@r.CreatedAtUtc.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            <td style="text-align:center;">
                                @if (r.Abandoned)
                                {
                                    <span class="status-pill status-pill--pending" title="6 deneme sonrasi terkedildi">@r.Attempts / @Kargoyeri.Studio.Core.Infrastructure.OutboundWebhookRetryQueue.MaxAttempts (terkedildi)</span>
                                }
                                else if (r.Attempts > 0)
                                {
                                    <strong>@r.Attempts</strong> <span style="color:#94a3b8;font-size:.78rem;">/ @Kargoyeri.Studio.Core.Infrastructure.OutboundWebhookRetryQueue.MaxAttempts</span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1;">â€”</span>
                                }
                            </td>
                            <td style="font-size:.78rem;color:#64748b;">
                                @(r.NextAttemptUtc is null ? "â€”" : r.NextAttemptUtc.Value.ToLocalTime().ToString("dd.MM HH:mm"))
                            </td>
                            <td style="font-size:.78rem;color:#dc2626;max-width:260px;word-break:break-word;">
                                @(string.IsNullOrWhiteSpace(r.ErrorMessage) ? "â€”" : r.ErrorMessage)
                            </td>
                            <td>
                                @if (r.Status == Kargoyeri.Contracts.Enums.NotificationDeliveryStatusDto.Failed)
                                {
                                    <form asp-action="RetryNow" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.NotificationId" />
                                        <button type="submit" class="ghost-link" style="font-size:.78rem;">Simdi Dene</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="kvkk-note" style="background:#f1f5f9;border-radius:10px;padding:12px 14px;font-size:12px;color:#475569;margin-top:18px;">
        Otomatik retry servisi her dakika basarisiz webhook'lari tarar ve schedule'a gore yeniden dener.
        Durum bilgileri <code>webhook-retry/webhook-retry-YYYYMMDD.jsonl</code> dosyalarina yazilir;
        servis yeniden baslarsa son 7 gunluk durum rehidre edilir.
    </div>
</section>

<style>
.metric-card {
    background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;
}
.metric-label { font-size:.72rem;text-transform:uppercase;color:#64748b;letter-spacing:.04em;font-weight:600; }
.metric-value { font-size:1.6rem;font-weight:700;color:#0f172a;margin-top:4px; }
</style>

@model AccessLoginUserViewModel
@{
    Layout = "_LoginShell";
    ViewData["Title"] = "Kullanıcı girişi";
    ViewData["AuthKicker"] = "Çalışma alanı";
    ViewData["AuthTitle"] = "Kullanıcı girişi";
    ViewData["AuthLead"] = $"{Model.TenantName} hesabına giriş yapıyorsunuz.";
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="auth-alert" role="alert">@Model.ErrorMessage</div>
}
<form asp-action="LoginUser" method="post" class="auth-form">
    <input type="hidden" asp-for="TenantKey" />
    <input type="hidden" asp-for="TenantName" />
    <label>
        <span>Kullanıcı adı</span>
        <span class="auth-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M5 19c1.4-3 3.8-4.5 7-4.5S17.6 16 19 19" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            <input asp-for="Username" autocomplete="username" />
        </span>
    </label>
    <label>
        <span>Şifre</span>
        <span class="auth-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <button class="auth-eye" type="button" data-toggle-password aria-label="Şifreyi göster">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
        </span>
    </label>
    <button class="auth-submit" type="submit">Giriş yap</button>
</form>
<p class="auth-back"><a asp-action="Login">Farklı hesapla giriş yap</a></p>

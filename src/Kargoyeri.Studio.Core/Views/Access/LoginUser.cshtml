@model AccessLoginUserViewModel
@{
    Layout = null;
    ViewData["Title"] = "Kullanici Girisi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri Studio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:24px;">
        <section class="panel-card" style="width:min(100%, 460px);">
            <p class="eyebrow">Kargoyeri Studio</p>
            <h1 style="margin:8px 0 4px;">Kullanici Girisi</h1>
            <p style="font-size:.85rem;color:var(--muted);margin-bottom:18px;">
                <strong>@Model.TenantName</strong> hesabina giris yapiyorsunuz.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="validation-summary-errors" style="margin-bottom:14px;">@Model.ErrorMessage</div>
            }

            <form asp-action="LoginUser" method="post" class="form-grid">
                <input type="hidden" asp-for="TenantKey" />
                <input type="hidden" asp-for="TenantName" />

                <label>
                    <span>Kullanici Adi</span>
                    <input asp-for="Username" autocomplete="username" />
                </label>
                <label>
                    <span>Sifre</span>
                    <input asp-for="Password" type="password" autocomplete="current-password" />
                </label>
                <button class="primary-button" type="submit">Giris Yap</button>
            </form>

            <div style="margin-top:16px;text-align:center;">
                <a asp-action="Login" style="font-size:.82rem;color:var(--muted);">&larr; Farkli hesapla giris yap</a>
            </div>
        </section>
    </main>
</body>
</html>

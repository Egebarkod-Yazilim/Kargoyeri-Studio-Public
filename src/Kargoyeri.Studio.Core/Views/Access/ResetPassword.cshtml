@model AccessResetPasswordViewModel
@{
    Layout = "_LoginShell";
    ViewData["Title"] = "Şifre sıfırlama";
    ViewData["AuthKicker"] = "Hesap";
    ViewData["AuthTitle"] = "Şifre sıfırlama";
    ViewData["AuthLead"] = "Yöneticinizden aldığınız sıfırlama kodu ile yeni şifrenizi belirleyin.";
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="auth-alert" role="alert">@Model.ErrorMessage</div>
}
<form asp-action="ResetPassword" method="post" class="auth-form">
    <label>
        <span>Müşteri kodu</span>
        <span class="auth-field"><input asp-for="TenantKey" autocomplete="organization" /></span>
    </label>
    <label>
        <span>Kullanıcı adı</span>
        <span class="auth-field"><input asp-for="Username" autocomplete="username" /></span>
    </label>
    <label>
        <span>Sıfırlama kodu</span>
        <span class="auth-field"><input asp-for="Token" autocomplete="one-time-code" /></span>
    </label>
    <label>
        <span>Yeni şifre</span>
        <span class="auth-field"><input asp-for="NewPassword" type="password" autocomplete="new-password" /></span>
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
    </label>
    <label>
        <span>Yeni şifre (tekrar)</span>
        <span class="auth-field"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></span>
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </label>
    <button class="auth-submit" type="submit">Şifreyi güncelle</button>
</form>
<p class="auth-back"><a asp-action="Login">Giriş ekranına dön</a></p>

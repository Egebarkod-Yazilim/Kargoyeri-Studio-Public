@model AccessResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sifre Sifirlama";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri Studio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:24px;">
        <section class="panel-card" style="width:min(100%, 460px);">
            <p class="eyebrow">Kargoyeri Studio</p>
            <h1 style="margin:8px 0 4px;">Sifre Sifirlama</h1>
            <p style="font-size:.85rem;color:var(--muted);margin-bottom:18px;">
                Yoneticinizden aldiginiz sifirlama token'i ile yeni sifrenizi belirleyin.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="validation-summary-errors" style="margin-bottom:14px;">@Model.ErrorMessage</div>
            }

            <form asp-action="ResetPassword" method="post" class="form-grid">
                <label>
                    <span>Musteri Kodu</span>
                    <input asp-for="TenantKey" autocomplete="organization" />
                </label>
                <label>
                    <span>Kullanici Adi</span>
                    <input asp-for="Username" autocomplete="username" />
                </label>
                <label>
                    <span>Sifirlama Token (yoneticiden alinan)</span>
                    <input asp-for="Token" autocomplete="one-time-code" style="font-family:monospace;letter-spacing:2px;text-transform:uppercase;" />
                </label>
                <label>
                    <span>Yeni Sifre</span>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </label>
                <label>
                    <span>Yeni Sifre (Tekrar)</span>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </label>
                <button class="primary-button" type="submit">Sifreyi Guncelle</button>
            </form>

            <div style="margin-top:16px;text-align:center;">
                <a asp-action="Login" style="font-size:.82rem;color:var(--muted);">&larr; Giris ekranina don</a>
            </div>
        </section>
    </main>
</body>
</html>

@model (string TenantKey, List<Kargoyeri.Studio.Core.Infrastructure.TenantUser> Users)
@{
    var tenantKey = Model.TenantKey;
    var users     = Model.Users;
}

@if (!users.Any())
{
    <p style="font-size:.85rem;color:var(--muted);">Bu musteri icin henuz kullanici tanimlanmamis.</p>
}
else
{
    <table class="studio-table" style="font-size:.83rem;">
        <thead>
            <tr>
                <th>Kullanici Adi</th>
                <th>Goruntulenen Ad</th>
                <th>E-posta</th>
                <th style="text-align:center;">Rol</th>
                <th style="text-align:center;">@L["Label_Status"]</th>
                <th style="text-align:right;">Olusturulma</th>
                <th style="text-align:right;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                <tr>
                    <td style="font-family:monospace;">@u.Username</td>
                    <td>@u.DisplayName</td>
                    <td style="font-size:.78rem;color:var(--muted);">
                        @(string.IsNullOrWhiteSpace(u.Email) ? "â€”" : u.Email)
                    </td>
                    <td style="text-align:center;">
                        <form asp-controller="TenantSwitch" asp-action="SetUserRole" method="post" style="display:inline;margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tenantKey" value="@tenantKey" />
                            <input type="hidden" name="username"  value="@u.Username" />
                            <select name="role" onchange="this.form.submit()"
                                    style="font-size:.75rem;padding:2px 4px;border-radius:4px;">
                                @foreach (var r in Kargoyeri.Studio.Core.Infrastructure.TenantUserRoles.All)
                                {
                                    <option value="@r" selected="@(u.Role == r)">@r</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td style="text-align:center;">
                        <span class="status-pill @(u.IsActive ? "status-pill--ready" : "status-pill--pending")"
                              style="font-size:.7rem;">
                            @(u.IsActive ? "Aktif" : "Pasif")
                        </span>
                    </td>
                    <td style="text-align:right;color:var(--muted);">
                        @u.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:6px;justify-content:flex-end;">
                            <form asp-controller="TenantSwitch" asp-action="ToggleUser" method="post" style="display:inline;margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenantKey" value="@tenantKey" />
                                <input type="hidden" name="username"  value="@u.Username" />
                                <input type="hidden" name="isActive"  value="@(!u.IsActive)" />
                                <button type="submit" class="secondary-button" style="font-size:.75rem;padding:4px 8px;">
                                    @(u.IsActive ? "Pasife Al" : "Aktif Et")
                                </button>
                            </form>
                            <form asp-controller="TenantSwitch" asp-action="IssueResetToken" method="post" style="display:inline;margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenantKey" value="@tenantKey" />
                                <input type="hidden" name="username"  value="@u.Username" />
                                <button type="submit" class="secondary-button" style="font-size:.75rem;padding:4px 8px;"
                                        onclick="return confirm('@u.Username icin sifre sifirlama token uretilsin mi? Mevcut token varsa gecersiz olur.')">
                                    Sifre Sifirla
                                </button>
                            </form>
                            <form asp-controller="TenantSwitch" asp-action="DeleteUser" method="post" style="display:inline;margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenantKey" value="@tenantKey" />
                                <input type="hidden" name="username"  value="@u.Username" />
                                <button type="submit" class="secondary-button"
                                        style="font-size:.75rem;padding:4px 8px;color:#dc2626;border-color:#dc2626;"
                                        onclick="return confirm('@u.Username kullanicisini silmek istiyor musunuz?')">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

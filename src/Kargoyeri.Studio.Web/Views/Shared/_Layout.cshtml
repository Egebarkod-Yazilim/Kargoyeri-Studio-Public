@inject Kargoyeri.Studio.Core.Infrastructure.IStudioWorkspaceContext WorkspaceContext
@inject Kargoyeri.Studio.Core.Infrastructure.WorkspaceBrandingStore BrandingStore
@using Kargoyeri.Studio.Core.Infrastructure
@{
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavClass(string ctrl) => _ctrl.Equals(ctrl, StringComparison.OrdinalIgnoreCase) ? "menu-active" : "";
    var isAdmin = User.IsInRole(StudioRoles.SuperAdmin);
    var isStudioAdmin = User.IsInRole(StudioRoles.Admin);
    var workspaceName = WorkspaceContext.GetCurrentName() ?? WorkspaceContext.GetCurrentCode();
    var branding = isAdmin || User.Identity?.IsAuthenticated != true
        ? new WorkspaceBrandingSettings()
        : await BrandingStore.GetCurrentAsync();
    var brandName = !isAdmin && !string.IsNullOrWhiteSpace(branding.DisplayName) ? branding.DisplayName : "Kargoyeri";
    var partnerLabel = !isAdmin && !string.IsNullOrWhiteSpace(branding.PartnerLabel) ? branding.PartnerLabel : "Kargo ayarlari ve takip paneli";
    var tabScope = isAdmin ? "superadmin" : isStudioAdmin ? "admin" : "operator";
    var theme = ViewContext.HttpContext.Request.Cookies["studio-theme"] ?? "light";
    var brandMark = string.Concat(brandName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    if (brandMark.Length < 2)
    {
        brandMark = "KY";
    }
}
<!DOCTYPE html>
<html lang="tr" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri</title>
    <link rel="stylesheet" href="~/_content/Kargoyeri.Studio.Core/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(branding.AccentColor))
    {
        <style>:root { --brand:@branding.AccentColor; --accent:@branding.AccentColor; }</style>
    }
</head>
<body>
    <div class="page-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">@brandMark</span>
                <span>
                    <strong>@brandName</strong>
                    <small>@partnerLabel</small>
                </span>
            </a>

            <nav class="menu">
                <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="@NavClass("Providers")" asp-controller="Providers" asp-action="Index">Kargo Firmaları</a>
                <a class="@NavClass("Shipments")" asp-controller="Shipments" asp-action="Index">Siparişler</a>
                <a class="@NavClass("BulkShipment")" asp-controller="BulkShipment" asp-action="Index">Toplu Gönderi</a>
                <a class="@NavClass("Pickup")" asp-controller="Pickup" asp-action="Index">Kurye Çağır</a>
                <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">Raporlar</a>
                <a class="@NavClass("Notifications")" asp-controller="Notifications" asp-action="Index">Bildirimler</a>
                <a class="@NavClass("WebhookDelivery")" asp-controller="WebhookDelivery" asp-action="Index">Webhook Teslimatları</a>
                @if (isAdmin)
                {
                    @* SuperAdmin: global management pages *@
                    <a class="@NavClass("Workspaces")" asp-controller="Workspaces" asp-action="Index">Entegrasyon</a>
                    <a class="@NavClass("ApiKeys")" asp-controller="ApiKeys" asp-action="Index">API Anahtarları</a>
                    <a class="@NavClass("AccountData")" asp-controller="AccountData" asp-action="Index">Veri Yönetimi</a>
                    <a class="@NavClass("Audit")" asp-controller="Audit" asp-action="Index">Audit Log</a>
                    <a class="@NavClass("ActivityLog")" asp-controller="ActivityLog" asp-action="Index">Aktivite Logu</a>
                    <a class="@NavClass("Worker")" asp-controller="Worker" asp-action="Index">Worker</a>
                }
            </nav>

            <div class="workspace-chip">
                <span>@(isAdmin ? "Süper Admin oturumu" : isStudioAdmin ? "Admin oturumu" : "Müşteri oturumu")</span>
                <strong>@workspaceName</strong>
                <form asp-controller="Access" asp-action="Logout" method="post" style="margin-top:12px;">
                    @Html.AntiForgeryToken()
                    <button class="ghost-link" type="submit" style="width:100%;justify-content:center;">Cikis Yap</button>
                </form>
            </div>
        </aside>

        <main class="content">
            <header class="topbar">
                <div>
                    <p class="topbar-label">Firma sec, ayar gir, islemi takip et</p>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <button type="button" class="topbar-theme-toggle" data-theme-toggle aria-label="Temayı değiştir" title="Temayı değiştir">
                    <span class="theme-icon-light">☀</span><span class="theme-icon-dark">☾</span>
                    <span class="theme-toggle-label">@(theme == "dark" ? "Gündüz teması" : "Gece teması")</span>
                </button>
            </header>

            <div class="workspace-tabs" data-workspace-tabs data-scope="@tabScope" aria-label="Açık sayfalar"></div>

            @{
                var flashMsg  = TempData["StudioMessage"] as string;
                var flashType = TempData["StudioMessageType"] as string ?? "info";
            }
            @if (!string.IsNullOrWhiteSpace(flashMsg))
            {
                var flashClass = flashType switch
                {
                    "success" => "flash flash--success",
                    "error"   => "flash flash--error",
                    "warning" => "flash flash--warning",
                    _         => "flash flash--info"
                };
                var flashIcon = flashType switch
                {
                    "success" => "&#10003;",
                    "error"   => "&#10007;",
                    "warning" => "&#9888;",
                    _         => "&#8505;"
                };
                <div class="@flashClass" role="alert">
                    <span class="flash-icon">@Html.Raw(flashIcon)</span>
                    <span>@flashMsg</span>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/_content/Kargoyeri.Studio.Core/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

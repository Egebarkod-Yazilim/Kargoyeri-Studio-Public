{
  "info": {
    "name": "Kargoyeri Studio API v1",
    "_postman_id": "kargoyeri-studio-v1",
    "description": "Kargoyeri Studio dis sistem entegrasyon REST API'si.\n\nAuth: Tum istekler `X-Api-Key` header'i ile dogrulanir. API key'i tenant tarafindan saglanir.\n\nBase URL: `{{baseUrl}}` (default: http://localhost:5000)\n\nDokuman: /swagger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "apiKey",  "value": "studio-demo-key",      "type": "string" }
  ],
  "item": [
    {
      "name": "Providers",
      "item": [
        {
          "name": "List providers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/providers", "host": ["{{baseUrl}}"], "path": ["api","v1","providers"] }
          }
        },
        {
          "name": "Provider status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/providers/status", "host": ["{{baseUrl}}"], "path": ["api","v1","providers","status"] }
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "List shipments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments?status=Pending&page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","shipments"],
              "query": [
                { "key": "status", "value": "Pending" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get shipment by reference",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/SHP-12345", "host": ["{{baseUrl}}"], "path": ["api","v1","shipments","SHP-12345"] }
          }
        },
        {
          "name": "Create shipment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderReference\": \"ORDER-001\",\n  \"clientShipmentReference\": \"CLIENT-001\",\n  \"provider\": \"Aras\",\n  \"source\": \"Manual\",\n  \"currencyCode\": \"TRY\",\n  \"sender\": {\n    \"name\": \"Gonderici A.S.\",\n    \"phone\": \"05550000001\",\n    \"city\": \"Istanbul\",\n    \"district\": \"Kadikoy\",\n    \"addressLine1\": \"Test Sokak No:1\",\n    \"countryCode\": \"TR\"\n  },\n  \"recipient\": {\n    \"name\": \"Alici Bey\",\n    \"phone\": \"05550000002\",\n    \"city\": \"Ankara\",\n    \"district\": \"Cankaya\",\n    \"addressLine1\": \"Hedef Caddesi No:5\",\n    \"countryCode\": \"TR\"\n  },\n  \"packages\": [\n    { \"packageSequence\": 1, \"weight\": 1.5, \"desi\": 2.0, \"description\": \"Test paketi\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments", "host": ["{{baseUrl}}"], "path": ["api","v1","shipments"] }
          }
        },
        {
          "name": "Refresh shipment status",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/SHP-12345/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","shipments","SHP-12345","refresh"] }
          }
        },
        {
          "name": "Cancel shipment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"reason\": \"Musteri iptal istegi\" }" },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/SHP-12345/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","shipments","SHP-12345","cancel"] }
          }
        },
        {
          "name": "Shipment operation logs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/SHP-12345/logs", "host": ["{{baseUrl}}"], "path": ["api","v1","shipments","SHP-12345","logs"] }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Provider callback (incoming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Webhook-Signature", "value": "<hmac-sha256-hex>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"ARK20260505000001\",\n  \"status\": \"Delivered\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\",\n  \"providerCode\": \"Aras\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/webhooks/callback", "host": ["{{baseUrl}}"], "path": ["api","v1","webhooks","callback"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] } }
        },
        {
          "name": "Regional health (P4)",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": { "raw": "{{baseUrl}}/healthz/regional", "host": ["{{baseUrl}}"], "path": ["healthz","regional"] } }
        }
      ]
    }
  ]
}

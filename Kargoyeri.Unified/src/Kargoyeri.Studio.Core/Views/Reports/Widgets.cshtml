@model DashboardPreferencePageViewModel
@{
    ViewData["Title"] = "Dashboard Widgetlari";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Dashboard</p>
        <h1 style="margin:0;font-size:1.35rem;">Widget Ozellestirme</h1>
    </div>
</div>

<section class="panel-card" style="max-width:760px;">
    <form method="post" asp-action="Widgets" class="form-grid">
        @Html.AntiForgeryToken()
        @foreach (var widget in Model.Widgets)
        {
            <label style="display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid var(--border);border-radius:12px;">
                <input type="checkbox" name="widgets" value="@widget.Key" checked="@widget.IsSelected" style="margin-top:3px;" />
                <span>
                    <strong style="display:block;">@widget.Title</strong>
                    <span style="color:var(--muted);font-size:.86rem;">@widget.Description</span>
                </span>
            </label>
        }
        <div style="display:flex;gap:10px;align-items:center;">
            <button type="submit" class="primary-button">Kaydet</button>
            <a class="ghost-link" asp-controller="Home" asp-action="Index">Dashboard'a Don</a>
        </div>
    </form>
</section>

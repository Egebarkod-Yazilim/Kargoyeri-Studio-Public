@model CodReportPageViewModel
@{
    ViewData["Title"] = "Kapida Odeme Raporu";
    string Money(decimal v) => v.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}

<section class="panel-card">
    <p class="eyebrow">@Model.WorkspaceName</p>
    <h2 style="margin:4px 0 6px;">Kapida Odeme (COD) Mutabakat Raporu</h2>
    <p style="color:#64748b;margin:0 0 18px;font-size:13px;">
        Belirtilen tarih aralinda olusturulan, tahsilat tutari olan gonderiler. Sadece teslim edilenler "tahsil edildi" sayilir.
    </p>

    <form method="get" asp-action="Cod" style="display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin-bottom:18px;">
        <label>
            <span style="display:block;font-size:12px;color:#64748b;">Baslangic</span>
            <input type="date" asp-for="Filter.From" class="form-input" />
        </label>
        <label>
            <span style="display:block;font-size:12px;color:#64748b;">Bitis</span>
            <input type="date" asp-for="Filter.To" class="form-input" />
        </label>
        <button type="submit" class="primary-button">Goster</button>
        <a class="secondary-button" asp-action="CodExportCsv" asp-route-From="@Model.Filter.From" asp-route-To="@Model.Filter.To">CSV indir</a>
        <a class="secondary-button" asp-action="Index">â† Standart Rapor</a>
    </form>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px;">
        <div class="stat-card"><div class="k">Adet</div><div class="v">@Model.Totals.Count</div></div>
        <div class="stat-card"><div class="k">Teslim Edilen</div><div class="v">@Model.Totals.DeliveredCount</div></div>
        <div class="stat-card"><div class="k">Toplam Tutar</div><div class="v">@Money(Model.Totals.TotalAmount) â‚º</div></div>
        <div class="stat-card"><div class="k">Tahsil Edilen</div><div class="v" style="color:#166534;">@Money(Model.Totals.CollectedAmount) â‚º</div></div>
    </div>

    @if (Model.ProviderSummary.Count > 0)
    {
        <h3 style="margin:20px 0 8px;font-size:15px;">Provider Ozeti</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Provider</th>
                    <th style="text-align:right;">Adet</th>
                    <th style="text-align:right;">Teslim</th>
                    <th style="text-align:right;">@L["Label_Total"]</th>
                    <th style="text-align:right;">Tahsil</th>
                    <th style="text-align:right;">Bekleyen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.ProviderSummary)
                {
                    <tr>
                        <td><strong>@s.Provider</strong></td>
                        <td style="text-align:right;">@s.Count</td>
                        <td style="text-align:right;">@s.DeliveredCount</td>
                        <td style="text-align:right;">@Money(s.TotalAmount) â‚º</td>
                        <td style="text-align:right;color:#166534;">@Money(s.CollectedAmount) â‚º</td>
                        <td style="text-align:right;color:#92400e;">@Money(s.PendingAmount) â‚º</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 style="margin:24px 0 8px;font-size:15px;">Gonderi Detayi (@Model.Rows.Count kayit)</h3>
    @if (Model.Rows.Count == 0)
    {
        <p style="color:#64748b;">Bu tarih aralinda kapida odemeli gonderi yok.</p>
    }
    else
    {
        <div style="overflow:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L["Label_Date"]</th>
                        <th>Gonderi No</th>
                        <th>Siparis</th>
                        <th>Provider</th>
                        <th>@L["Label_Status"]</th>
                        <th>Sehir</th>
                        <th>Odeme</th>
                        <th style="text-align:right;">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td><a asp-controller="Shipments" asp-action="Detail" asp-route-shipmentReference="@r.ShipmentReference">@r.ShipmentReference</a></td>
                            <td>@r.OrderReference</td>
                            <td>@r.Provider</td>
                            <td>
                                @if (r.IsDelivered)
                                {
                                    <span class="badge success">@r.Status</span>
                                }
                                else
                                {
                                    <span class="badge neutral">@r.Status</span>
                                }
                            </td>
                            <td>@(r.RecipientCity ?? "â€”")</td>
                            <td>
                                @switch (r.PaymentType)
                                {
                                    case "cod_card":
                                        <span title="Kapida Kredi Karti">ğŸ’³ Kart</span>
                                        break;
                                    case "cod_cash":
                                        <span title="Kapida Nakit">ğŸ’µ Nakit</span>
                                        break;
                                    default:
                                        <span>@r.PaymentType</span>
                                        break;
                                }
                            </td>
                            <td style="text-align:right;font-weight:600;">@Money(r.Amount) @r.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<style>
    .stat-card { background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:14px; }
    .stat-card .k { font-size:11px;text-transform:uppercase;color:#94a3b8;letter-spacing:.6px; }
    .stat-card .v { font-size:22px;font-weight:600;margin-top:6px;color:#0f172a; }
    .badge { display:inline-block;padding:2px 10px;border-radius:999px;font-size:11px;font-weight:600; }
    .badge.success { background:#dcfce7;color:#166534; }
    .badge.neutral { background:#e2e8f0;color:#475569; }
</style>

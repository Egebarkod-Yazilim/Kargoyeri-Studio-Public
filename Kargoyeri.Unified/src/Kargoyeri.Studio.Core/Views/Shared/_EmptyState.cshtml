@*
    P3-#4 — Empty-state partial
    Kullanim:
      @await Html.PartialAsync("_EmptyState", new EmptyStateModel {
          Icon = "\U0001F4E6",
          Title = "Henuz gonderi yok",
          Message = "Ilk gonderini olusturmak icin asagidaki butonu kullan.",
          CtaText = "Yeni gonderi",
          CtaUrl = Url.Action("Create", "Shipments")
      })
*@
@model Kargoyeri.Studio.Core.Models.EmptyStateModel
<div class="empty-state">
    <div class="empty-state-icon">@(string.IsNullOrWhiteSpace(Model.Icon) ? "\U0001F4ED" : Model.Icon)</div>
    <h3 class="empty-state-title">@Model.Title</h3>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p class="empty-state-msg">@Model.Message</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CtaText) && !string.IsNullOrWhiteSpace(Model.CtaUrl))
    {
        <a class="empty-state-cta" href="@Model.CtaUrl">@Model.CtaText</a>
    }
</div>

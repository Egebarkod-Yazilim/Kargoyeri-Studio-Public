@model AccessLoginTotpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iki Adimli Dogrulama";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kargoyeri Studio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:24px;">
        <section class="panel-card" style="width:min(100%, 460px);">
            <p class="eyebrow">Kargoyeri Studio</p>
            <h1 style="margin:8px 0 4px;">Iki Adimli Dogrulama</h1>
            <p style="font-size:.85rem;color:var(--muted);margin-bottom:18px;">
                <strong>@(string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.Username : Model.DisplayName)</strong> hesabi icin authenticator uygulamanizda goruntulenen
                6 haneli kodu girin.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="validation-summary-errors" style="margin-bottom:14px;">@Model.ErrorMessage</div>
            }

            <form asp-action="@(Model.IsAdmin ? "LoginAdminTotp" : "LoginTotp")" method="post" class="form-grid" autocomplete="off">
                <label>
                    <span>Dogrulama Kodu</span>
                    <input asp-for="Code" inputmode="numeric" pattern="[0-9]{6}"
                           maxlength="6" style="font-size:1.4rem;letter-spacing:.4em;text-align:center;font-family:monospace;"
                           autofocus />
                    <span asp-validation-for="Code" class="field-validation-error"></span>
                </label>
                <button class="primary-button" type="submit">Dogrula</button>
            </form>

            <div style="margin-top:16px;text-align:center;">
                <a asp-action="Login" style="font-size:.82rem;color:var(--muted);">&larr; Iptal et ve yeniden baslat</a>
            </div>
        </section>
    </main>
</body>
</html>

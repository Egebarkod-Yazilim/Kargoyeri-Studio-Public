@model IReadOnlyList<Kargoyeri.Studio.Core.Infrastructure.TenantInvoice>
@{
    var year = (int)ViewData["Year"]!;
    var month = (int)ViewData["Month"]!;
    var tier = (Kargoyeri.Studio.Core.Infrastructure.BillingTier)ViewData["Tier"]!;
    var persistedDates = (IReadOnlyList<DateOnly>)ViewData["PersistedDates"]!;
    var totalRevenue = Model.Sum(i => i.Total);
    var totalShipments = Model.Sum(i => i.ShipmentsCreated);
}

<div class="topbar" style="margin-bottom:14px;">
    <p class="topbar-label">P4-#2 Billing</p>
    <h2 style="margin:0;">@year-@month.ToString("00") aylik fatura tablosu</h2>
</div>

<form method="get" style="display:flex;gap:10px;align-items:end;margin-bottom:18px;">
    <label>
        <span style="font-size:.78rem;color:var(--muted);">Yil</span>
        <input class="form-input" type="number" name="year" value="@year" min="2024" max="2099" style="width:100px;" />
    </label>
    <label>
        <span style="font-size:.78rem;color:var(--muted);">Ay</span>
        <input class="form-input" type="number" name="month" value="@month" min="1" max="12" style="width:80px;" />
    </label>
    <button class="primary-btn" type="submit">Goster</button>
    <span style="margin-left:auto;font-size:.78rem;color:var(--muted);">
        @persistedDates.Count gunluk snapshot kayitli
    </span>
</form>

<div class="cdash-grid" style="margin-bottom:18px;">
    <div class="cdash-kpi tone-blue">
        <span class="kpi-icon">&#128100;</span>
        <div class="kpi-label">Tenant sayisi</div>
        <div class="kpi-value">@Model.Count</div>
    </div>
    <div class="cdash-kpi tone-violet">
        <span class="kpi-icon">&#128230;</span>
        <div class="kpi-label">Toplam gonderi</div>
        <div class="kpi-value">@totalShipments</div>
    </div>
    <div class="cdash-kpi tone-green">
        <span class="kpi-icon">&#128181;</span>
        <div class="kpi-label">Brut gelir (@tier.Currency)</div>
        <div class="kpi-value">@totalRevenue.ToString("N2")</div>
    </div>
    <div class="cdash-kpi tone-amber">
        <span class="kpi-icon">&#127894;</span>
        <div class="kpi-label">Tier</div>
        <div class="kpi-value" style="font-size:1rem;line-height:1.3;">
            @tier.MonthlyBaseFee.ToString("N0") @tier.Currency<br />
            <small style="font-size:.7rem;font-weight:400;opacity:.85;">+@tier.IncludedShipments dahil, +@tier.PricePerExtraShipment.ToString("N2")/asim</small>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new Kargoyeri.Studio.Core.Models.EmptyStateModel
    {
        Icon = "\U0001F4B3",
        Title = "Bu donemde fatura yok",
        Message = "Snapshot dosyalari henuz olusmamis olabilir. Tenant Metrics aggregator gunluk olarak calisir.",
        CtaText = "Onceki ay",
        CtaUrl = Url.Action("Index", "Billing", new { year = month == 1 ? year - 1 : year, month = month == 1 ? 12 : month - 1 })
    })
}
else
{
    <div class="table-shell" style="overflow-x:auto;">
        <table class="studio-table">
            <thead>
                <tr>
                    <th>Tenant</th>
                    <th style="text-align:right;">Olusan</th>
                    <th style="text-align:right;">Teslim</th>
                    <th style="text-align:right;">Asim</th>
                    <th style="text-align:right;">Subtotal</th>
                    <th style="text-align:right;">KDV</th>
                    <th style="text-align:right;">@L["Label_Total"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    <tr>
                        <td><strong>@inv.TenantName</strong><br /><small style="color:var(--muted);">@inv.TenantKey</small></td>
                        <td style="text-align:right;">@inv.ShipmentsCreated</td>
                        <td style="text-align:right;">@inv.ShipmentsDelivered</td>
                        <td style="text-align:right;">@inv.ExtraShipments</td>
                        <td style="text-align:right;">@inv.Subtotal.ToString("N2")</td>
                        <td style="text-align:right;">@inv.Vat.ToString("N2")</td>
                        <td style="text-align:right;font-weight:700;">@inv.Total.ToString("N2") @inv.Currency</td>
                        <td><a href="@Url.Action("Invoice", "Billing", new { tenantKey = inv.TenantKey, year, month })">Fatura</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

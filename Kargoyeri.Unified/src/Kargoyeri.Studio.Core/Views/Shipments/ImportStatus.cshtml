@model Kargoyeri.Studio.Core.Infrastructure.CsvImportJob
@{
    ViewData["Title"] = "Import Durumu";
    var isRunning = Model.State == Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Running
                    || Model.State == Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Queued;
}

@if (isRunning)
{
    <meta http-equiv="refresh" content="2" />
}

<div class="page-header">
    <div>
        <p class="eyebrow">Gonderi Yonetimi</p>
        <h1 style="margin:0;">Toplu Import Durumu</h1>
    </div>
    <a asp-action="Import" class="ghost-link">&larr; Yeni Import</a>
</div>

<div class="panel-card" style="margin-top:18px;">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
        <div>
            <div style="font-size:.78rem;color:var(--muted);">Job ID</div>
            <div style="font-family:monospace;font-size:.9rem;">@Model.Id</div>
            <div style="font-size:.78rem;color:var(--muted);margin-top:6px;">Dosya: @Model.FileName</div>
        </div>
        <div style="text-align:right;">
            <span class="status-pill @(Model.State switch {
                Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Completed => "status-pill--ready",
                Kargoyeri.Studio.Core.Infrastructure.CsvImportJobState.Failed    => "status-pill--pending",
                _ => "status-pill--pending"
            })" style="font-size:.85rem;">@Model.State</span>
            <div style="font-size:.78rem;color:var(--muted);margin-top:6px;">
                @Model.EnqueuedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
            </div>
        </div>
    </div>

    <div style="margin-top:18px;">
        <div style="display:flex;justify-content:space-between;font-size:.85rem;margin-bottom:4px;">
            <span>Ilerleme</span>
            <span>@Model.ProcessedCount / @Model.TotalRows (%@Model.ProgressPercent)</span>
        </div>
        <div style="background:rgba(0,0,0,.08);height:10px;border-radius:5px;overflow:hidden;">
            <div style="background:linear-gradient(90deg,#2563eb,#7c3aed);height:100%;width:@(Model.ProgressPercent)%;transition:width .3s;"></div>
        </div>
        <div style="display:flex;gap:16px;margin-top:10px;font-size:.85rem;">
            <span style="color:#16a34a;"><strong>@Model.SuccessCount</strong> basarili</span>
            <span style="color:#dc2626;"><strong>@Model.FailedCount</strong> basarisiz</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.FatalError))
    {
        <div class="validation-summary-errors" style="margin-top:14px;">
            Fatal hata: @Model.FatalError
        </div>
    }

    @if (Model.Errors.Count > 0)
    {
        <details style="margin-top:14px;">
            <summary style="cursor:pointer;font-size:.85rem;color:var(--muted);">Hatalar (@Model.Errors.Count)</summary>
            <ul style="margin-top:8px;font-size:.82rem;color:#dc2626;padding-left:18px;">
                @foreach (var err in Model.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        </details>
    }

    @if (!isRunning)
    {
        <div style="margin-top:18px;">
            <a asp-action="Index" class="primary-button">Gonderi Listesine Don</a>
        </div>
    }
    else
    {
        <p style="margin-top:14px;font-size:.82rem;color:var(--muted);">Sayfa otomatik yenileniyor (2 sn)...</p>
    }
</div>

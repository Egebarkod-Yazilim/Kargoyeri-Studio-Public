@model ApiKeysPageViewModel
@{
    ViewData["Title"] = "API Anahtarlari";
}

<section class="panel-card" style="max-width:920px;">
    <p class="eyebrow">@Model.TenantName Â· Entegrasyon</p>
    <h1 style="margin:6px 0 8px;">API Anahtarlari</h1>
    <p class="provider-index-note">
        REST API uclarini (<code>/api/v1/...</code>) kullanmak icin <code>X-Api-Key</code> header'inda
        gecerli bir anahtar gondermeniz gerekir. Her anahtar bu tenant'a baglidir; kaybolursa veya
        sizdirilirsa <strong>pasiflestirin</strong> ve yenisini olusturun.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.NewlyCreatedPlainKey))
    {
        <div class="validation-summary-errors"
             style="background:#dcfce7;color:#166534;border-color:#86efac;margin-top:18px;">
            <strong>Yeni anahtar olusturuldu â€” '@Model.NewlyCreatedName'</strong>
            <p style="margin:8px 0 4px;">
                Asagidaki anahtari simdi kopyalayip guvenli bir yere kaydedin. Bir daha gosterilmeyecek.
            </p>
            <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
                <code id="new-key-display"
                      style="flex:1;padding:10px 14px;background:#fff;border:1px solid #86efac;
                             border-radius:8px;font-size:14px;word-break:break-all;">@Model.NewlyCreatedPlainKey</code>
                <button type="button" class="primary-button" style="background:#16a34a;border-color:#16a34a;"
                        onclick="navigator.clipboard.writeText(document.getElementById('new-key-display').innerText);this.innerText='Kopyalandi!'">
                    Kopyala
                </button>
            </div>
        </div>
    }

    <h2 style="font-size:1.05rem;margin:24px 0 6px;">Yeni Anahtar Olustur</h2>
    <form asp-action="Create" method="post" class="form-grid" style="display:flex;gap:10px;align-items:flex-end;">
        @Html.AntiForgeryToken()
        <label style="flex:1;">
            <span>Anahtar Adi (uretici sistem adi vs.)</span>
            <input name="name" maxlength="80" placeholder="Ornek: Trendyol Entegrasyonu" required />
        </label>
        <button class="primary-button" type="submit">@L["Action_Create"]</button>
    </form>

    <h2 style="font-size:1.05rem;margin:30px 0 6px;">Mevcut Anahtarlar</h2>
    @if (Model.Keys.Count == 0)
    {
        <p style="color:#94a3b8;font-size:.9rem;margin:8px 0 0;">Henuz anahtar olusturulmamis.</p>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;margin-top:8px;">
            <thead>
                <tr style="background:#f1f5f9;">
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Ad</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Prefix</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Olusturma</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Son Kullanim</th>
                    <th style="text-align:left;padding:10px;border:1px solid #e2e8f0;">Durum</th>
                    <th style="text-align:right;padding:10px;border:1px solid #e2e8f0;">Islem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Keys.OrderByDescending(x => x.CreatedAt))
                {
                    <tr>
                        <td style="padding:10px;border:1px solid #e2e8f0;">@k.Name</td>
                        <td style="padding:10px;border:1px solid #e2e8f0;"><code>@k.Prefix...</code></td>
                        <td style="padding:10px;border:1px solid #e2e8f0;font-size:.85rem;color:#64748b;">@k.CreatedAt.ToLocalTime():dd.MM.yyyy HH:mm</td>
                        <td style="padding:10px;border:1px solid #e2e8f0;font-size:.85rem;color:#64748b;">
                            @(k.LastUsedAt is null ? "â€”" : k.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                        </td>
                        <td style="padding:10px;border:1px solid #e2e8f0;">
                            @if (k.IsRevoked) { <span class="badge danger">Pasif</span> }
                            else { <span class="badge success">Aktif</span> }
                        </td>
                        <td style="padding:10px;border:1px solid #e2e8f0;text-align:right;">
                            @if (!k.IsRevoked)
                            {
                                <form asp-action="Revoke" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyId" value="@k.Id" />
                                    <button class="ghost-link" type="submit"
                                            onclick="return confirm('Bu anahtari pasiflestirmek istediginize emin misiniz?');">
                                        Pasiflestir
                                    </button>
                                </form>
                            }
                            @if (User.IsInRole(StudioRoles.Admin))
                            {
                                <form asp-action="Delete" method="post" style="display:inline;margin-left:8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyId" value="@k.Id" />
                                    <button class="ghost-link" type="submit" style="color:#dc2626;"
                                            onclick="return confirm('Anahtari KALICI olarak silmek istediginize emin misiniz?');">
                                        Sil
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="kvkk-note" style="background:#f1f5f9;border-radius:10px;padding:12px 14px;font-size:12px;color:#475569;margin-top:24px;">
        <strong>Kullanim:</strong>
        <pre style="margin:6px 0 0;font-size:11px;background:#0f172a;color:#e2e8f0;padding:10px 12px;border-radius:6px;overflow-x:auto;">curl -H "X-Api-Key: kgy_..." https://app/api/v1/shipments</pre>
    </div>
</section>

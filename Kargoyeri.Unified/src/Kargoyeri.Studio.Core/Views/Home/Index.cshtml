@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var ws = Model.WorkerStatus;
    var workerPill = ws.IsRunning ? "status-pill--ready"
                   : !ws.IsHealthy ? "status-pill--pending"
                   : ws.LastSuccessAt.HasValue ? "status-pill--ready" : "";
    var workerLabel = ws.IsRunning ? "Calisyor"
                    : !ws.IsHealthy ? $"{ws.ConsecutiveErrors} Hata"
                    : ws.LastSuccessAt.HasValue ? "Aktif" : "Bekleniyor";
    var widgetSet = Model.VisibleWidgets.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var showOverview = widgetSet.Count == 0 || widgetSet.Contains("overview");
    var showCharts = widgetSet.Count == 0 || widgetSet.Contains("charts");
    var showNotifications = widgetSet.Count == 0 || widgetSet.Contains("notifications");
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.WorkspaceName</p>
        <h1 style="margin:0;font-size:1.35rem;">Dashboard</h1>
    </div>
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <a class="ghost-link" asp-controller="Reports" asp-action="Widgets">Widgetlari Ozellestir</a>
        <span style="font-size:.8rem;color:var(--muted);">
            @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
        </span>
    </div>
</div>

@if (showOverview)
{
    <div class="metric-strip" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;">
        <div class="metric-card">
            <span>Hazir Firma</span>
            <strong>@Model.ReadyProviderCount <small style="font-weight:400;font-size:.8em;color:var(--muted);">/ @Model.ProviderCount</small></strong>
        </div>
        <div class="metric-card">
            <span>Gonderi</span>
            <strong>@Model.ShipmentCount</strong>
        </div>
        <div class="metric-card">
            <span>Bildirim</span>
            <strong>@Model.NotificationCount</strong>
        </div>
        <div class="metric-card" style="border-color:@(ws.IsHealthy ? "var(--border)" : "rgba(224,92,78,.35)");">
            <span>Worker</span>
            <strong>
                <span class="status-pill @workerPill" style="font-size:.73rem;">@workerLabel</span>
            </strong>
            @if (ws.LastSuccessAt.HasValue)
            {
                <small style="font-size:.72rem;color:var(--muted);display:block;margin-top:4px;">
                    @ws.LastSuccessAt.Value.ToLocalTime().ToString("HH:mm:ss") &middot; @ws.TotalProcessed islendi
                </small>
            }
            @if (!string.IsNullOrWhiteSpace(ws.LastError))
            {
                <small style="font-size:.7rem;color:#e05c4e;display:block;margin-top:4px;word-break:break-word;" title="@ws.LastError">
                    @(ws.LastError.Length > 60 ? ws.LastError[..60] + "..." : ws.LastError)
                </small>
            }
            <a class="ghost-link" asp-controller="Worker" asp-action="Index" style="margin-top:8px;font-size:.8rem;">Detaylari Ac</a>
        </div>
    </div>
}

@if (showCharts && Model.ShipmentCount > 0)
{
    <div class="chart-grid" style="margin-top:24px;">
        <div class="panel-card chart-panel">
            <p class="eyebrow" style="margin-bottom:12px;">Gonderi Durumlari</p>
            <div class="chart-wrap">
                <canvas id="chartStatus" height="220"></canvas>
            </div>
            <div class="chart-legend" id="legendStatus"></div>
        </div>

        <div class="panel-card chart-panel">
            <p class="eyebrow" style="margin-bottom:12px;">Firmalara Gore Gonderi</p>
            <div class="chart-wrap">
                <canvas id="chartProvider" height="220"></canvas>
            </div>
        </div>

        <div class="panel-card chart-panel chart-panel--wide">
            <p class="eyebrow" style="margin-bottom:12px;">Son 7 Gunluk Gonderi Trendi</p>
            <div class="chart-wrap">
                <canvas id="chartTrend" height="160"></canvas>
            </div>
        </div>
    </div>

    @if (showNotifications && Model.NotificationsByChannel.Any())
    {
        <div class="notif-channel-row" style="margin-top:16px;">
            @foreach (var ch in Model.NotificationsByChannel)
            {
                var pct = ch.Value.Total > 0 ? (int)Math.Round(ch.Value.Delivered * 100.0 / ch.Value.Total) : 0;
                <div class="notif-channel-card">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;">
                        <span class="cap-tag" style="font-size:.78rem;">@ch.Key</span>
                        <span style="font-size:.82rem;font-weight:600;color:var(--text);">@ch.Value.Total adet</span>
                    </div>
                    <div class="mini-bar-track">
                        <div class="mini-bar-fill mini-bar-fill--ok" style="width:@pct%"></div>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:.75rem;color:var(--muted);">
                        <span style="color:var(--secondary);">&#10003; @ch.Value.Delivered basarili</span>
                        @if (ch.Value.Failed > 0)
                        {
                            <span style="color:#e05252;">&#10005; @ch.Value.Failed basarisiz</span>
                        }
                        else
                        {
                            <span>%@pct basari</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
else if (Model.ShipmentCount == 0)
{
    <div class="panel-card" style="margin-top:24px;padding:40px;text-align:center;">
        <p class="eyebrow" style="margin-bottom:8px;">Henuz gonderi yok</p>
        <p style="color:var(--muted);font-size:.88rem;margin:0;">
            Analitik veriler ilk gonderi olusturulduktan sonra gozukecek.
        </p>
        <a class="primary-button" asp-controller="Shipments" asp-action="Index" style="display:inline-block;margin-top:16px;">
            Siparisler &rarr;
        </a>
    </div>
}

@section Scripts {
    @if (showCharts && Model.ShipmentCount > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
    const PALETTE = {
        delivered:  '#16a34a',
        intransit:  '#0891b2',
        pending:    '#d97706',
        failed:     '#dc2626',
        cancelled:  '#9ca3af',
        other:      '#6b7280'
    };

    const statusColor = (label) => {
        const l = label.toLowerCase();
        if (l.includes('delivered')) return PALETTE.delivered;
        if (l.includes('transit')) return PALETTE.intransit;
        if (l.includes('failed')) return PALETTE.failed;
        if (l.includes('cancel')) return PALETTE.cancelled;
        if (l.includes('pending') || l.includes('queued') || l.includes('label') || l.includes('accepted')) return PALETTE.pending;
        return PALETTE.other;
    };

    Chart.defaults.color = '#587860';
    Chart.defaults.borderColor = '#c6ddc9';
    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';

    (function() {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShipmentsByStatus.Keys.ToList()));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShipmentsByStatus.Values.ToList()));
        const colors = labels.map(statusColor);
        const ctx = document.getElementById('chartStatus');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: colors, borderColor: '#ffffff', borderWidth: 3, hoverOffset: 6 }] },
            options: {
                cutout: '68%',
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ` ${ctx.label}: ${ctx.parsed} gonderi` } }
                }
            }
        });
        const legend = document.getElementById('legendStatus');
        if (legend) {
            legend.innerHTML = labels.map((l, i) =>
                `<span class="chart-legend-item"><i style="background:${colors[i]}"></i>${l} <b>${data[i]}</b></span>`
            ).join('');
        }
    })();

    (function() {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShipmentsByProvider.Keys.ToList()));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShipmentsByProvider.Values.ToList()));
        const ctx = document.getElementById('chartProvider');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [{ label: 'Gonderi', data, backgroundColor: 'rgba(22,163,74,.75)', borderColor: '#16a34a', borderWidth: 1, borderRadius: 6, hoverBackgroundColor: '#16a34a' }]
            },
            options: {
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: { x: { grid: { color: '#c6ddc9' }, ticks: { precision: 0 } }, y: { grid: { display: false } } }
            }
        });
    })();

    (function() {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendCounts));
        const ctx = document.getElementById('chartTrend');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [{ label: 'Gonderi', data, borderColor: '#16a34a', backgroundColor: 'rgba(22,163,74,.10)', pointBackgroundColor: '#16a34a', pointRadius: 4, pointHoverRadius: 6, fill: true, tension: 0.38 }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#c6ddc9' } },
                    y: { grid: { color: '#c6ddc9' }, ticks: { precision: 0 }, beginAtZero: true }
                }
            }
        });
    })();
        </script>
    }
}

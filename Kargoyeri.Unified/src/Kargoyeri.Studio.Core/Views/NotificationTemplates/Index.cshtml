@model NotificationTemplatePageViewModel
@{
    ViewData["Title"] = "Bildirim Sablonlari";
}

<section class="section-heading">
    <div>
        <p class="eyebrow">Bildirim Sablonlari</p>
        <h1>@Model.WorkspaceName</h1>
    </div>
    <a class="ghost-link" asp-controller="Notifications" asp-action="Index">Bildirim Kayitlari</a>
</section>

<div class="panel-card" style="margin-bottom:18px;">
    <p style="margin:0;font-size:.88rem;color:var(--muted);">
        Bu ekran tenant bazli e-posta ve SMS metinlerini metadata icinde saklar.
        Canli dispatch katmani ayni anahtari okumaya baglandiginda gonderimler bu sablonlardan beslenecektir.
        Kullanilabilir alanlar: <code>{{customerName}}</code>, <code>{{shipmentReference}}</code>,
        <code>{{trackingNumber}}</code>, <code>{{status}}</code>, <code>{{message}}</code>.
    </p>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;">
        @for (var i = 0; i < Model.Templates.Count; i++)
        {
            <section class="panel-card">
                <input type="hidden" asp-for="Templates[@i].EventType" />
                <input type="hidden" asp-for="Templates[@i].Channel" />

                <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:12px;">
                    <div>
                        <p class="eyebrow" style="margin-bottom:4px;">@Model.Templates[i].Channel</p>
                        <h3 style="margin:0;">@Model.Templates[i].EventType</h3>
                    </div>
                    <label style="display:flex;align-items:center;gap:8px;font-size:.84rem;">
                        <input asp-for="Templates[@i].IsEnabled" />
                        Aktif
                    </label>
                </div>

                <label style="display:block;margin-bottom:10px;">
                    <span style="display:block;font-size:.8rem;color:var(--muted);margin-bottom:6px;">Konu</span>
                    <input asp-for="Templates[@i].SubjectTemplate" class="form-input" />
                </label>

                <label style="display:block;">
                    <span style="display:block;font-size:.8rem;color:var(--muted);margin-bottom:6px;">Mesaj</span>
                    <textarea asp-for="Templates[@i].BodyTemplate" class="form-input" rows="6"></textarea>
                </label>
            </section>
        }
    </div>

    <div style="margin-top:18px;display:flex;justify-content:flex-end;">
        <button type="submit" class="primary-button">Kaydet</button>
    </div>
</form>

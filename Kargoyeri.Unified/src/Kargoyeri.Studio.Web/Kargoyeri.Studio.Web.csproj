<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Dev ortami icin User Secrets: Storage:ConnectionString, Smtp:Password, Netgsm:Password, StudioAccess:AdminAccessCode vb. -->
    <UserSecretsId>kargoyeri-studio-web-dev</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NU1902: OpenTelemetry.Exporter.OpenTelemetryProtocol GHSA-4625-4j76-fww9 — gRPC.Core transitive deprecation. Sadece informational; runtime impact yok. -->
    <NoWarn>$(NoWarn);1591;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kargoyeri.Studio.Core\Kargoyeri.Studio.Core.csproj" />
    <ProjectReference Include="..\Kargoyeri.Application\Kargoyeri.Application.csproj" />
    <ProjectReference Include="..\Kargoyeri.Infrastructure\Kargoyeri.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <!-- Serilog: yapilandirilmis log + Seq sink. Seq URL'i yoksa yalnizca Console kullanilir. -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="7.0.1" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.3.0" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="2.0.2" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- P5-#5 Sentry: hata raporlama + performans tracing -->
    <PackageReference Include="Sentry.AspNetCore" Version="4.13.0" />
    <!-- P5-#5 OpenTelemetry: distributed tracing + metrics, OTLP exporter -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.9.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta.12" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.10.0" />
  </ItemGroup>


</Project>
